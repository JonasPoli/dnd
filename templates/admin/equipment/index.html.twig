{% extends 'base_admin.html.twig' %}

{% block header_title %}Equipamentos{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@latest/dist/style.css" rel="stylesheet" type="text/css">
{% endblock %}

{% block body %}
<div class="mb-8 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold dark:text-white">Equipamentos e Itens</h1>
        <p class="text-slate-500 text-sm">Gerencie o catálogo de armas, armaduras e itens gerais.</p>
    </div>
    <a href="{{ path('admin_equipment_new') }}" class="bg-primary text-white px-6 py-3 rounded-2xl font-bold shadow-lg shadow-primary/25 hover:bg-primary/90 transition-all flex items-center space-x-2">
        {{ ux_icon('lucide:plus', {class: 'w-5 h-5'}) }}
        <span>Novo Equipamento</span>
    </a>
</div>

{# Filter Panel #}
<div class="mb-6 bg-white dark:bg-slate-900 rounded-2xl border border-border p-4 shadow-sm">
    <form method="get" class="flex gap-3 items-end">
        <div class="flex-1 max-w-xs">
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Status</label>
            <select name="status" class="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none">
                <option value="active" {% if status_filter == 'active' %}selected{% endif %}>Ativos</option>
                <option value="inactive" {% if status_filter == 'inactive' %}selected{% endif %}>Inativos</option>
                <option value="all" {% if status_filter == 'all' %}selected{% endif %}>Todos</option>
            </select>
        </div>
        <button type="submit" class="px-4 py-2 bg-primary text-white rounded-xl text-sm font-semibold hover:bg-primary/90 transition-all">
            Filtrar
        </button>
    </form>
</div>

<div class="bg-white dark:bg-slate-900 rounded-3xl border border-border overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
        <table id="equipmentTable" class="w-full text-left">
            <thead>
                    <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400">Nome / Nome (PT)</th>
                    <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400">Tipo / Categoria</th>
                    <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400">Descrição (PT) / Peso</th>
                    <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400 text-right">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border">
                {% for equipment in equipment_list %}
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                        <td class="px-8 py-5">
                            <div class="font-bold text-slate-900 dark:text-white">{{ equipment.name }}</div>
                            <div class="text-xs text-slate-400">{{ equipment.namePt|default('-') }}</div>
                        </td>
                        <td class="px-8 py-5">
                            <div class="text-sm font-medium">{{ equipment.typePt|default(equipment.type) }}</div>
                            <div class="text-xs text-slate-400">{{ equipment.weaponCategoryPt|default('-') }}</div>
                        </td>
                        <td class="px-8 py-5">
                            <div class="text-xs text-slate-600 dark:text-slate-400 mb-1" title="{{ equipment.descriptionMdPt }}">{{ equipment.descriptionMdPt|striptags|slice(0, 50) ~ '...' }}</div>
                            <div class="text-xs font-bold text-slate-400">{{ equipment.weightKg ? equipment.weightKg ~ ' kg' : '-' }}</div>
                        </td>
                        <td class="px-8 py-5 text-right">
                            <div class="flex items-center justify-end space-x-3">
                                <a href="{{ path('admin_equipment_edit', {'id': equipment.id}) }}" class="p-2 bg-slate-100 dark:bg-slate-800 rounded-xl text-slate-500 hover:text-primary transition-colors">
                                    {{ ux_icon('lucide:edit-3', {class: 'w-5 h-5'}) }}
                                </a>
                                {{ include('admin/equipment/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="px-8 py-12 text-center text-slate-400">
                            Nenhum equipamento encontrado.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/simple-datatables@latest" type="text/javascript"></script>
<script>
    const dataTable = new simpleDatatables.DataTable("#equipmentTable", {
        searchable: true,
        fixedHeight: true,
        perPage: 15,
        labels: {
            placeholder: "Pesquisar...",
            perPage: "{select} itens por página",
            noRows: "Nenhum registro encontrado",
            info: "Mostrando {start} até {end} de {rows} registros",
        }
    });
</script>
{% endblock %}
