<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>{{ character.name }} - Ficha de Personagem</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        serif: ['Georgia', 'Cambria', 'Times New Roman', 'serif'],
                        sans: ['Arial', 'Helvetica', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <style>
        @media print {
            @page { size: A4; margin: 0mm; }
            body { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
            .page-break { break-after: page; }
            .no-print { display: none !important; }
        }

        body { background: #525252; font-family: Arial, sans-serif; }
        
        .sheet-page {
            width: 210mm;
            height: 297mm;
            background: #fffbf0;
            margin: 0 auto;
            position: relative;
            overflow: hidden;
            border: 1px solid #d1d5db;
        }

        /* Vintage decorative border */
        .sheet-page::before {
            content: "";
            position: absolute;
            top: 6mm; bottom: 6mm; left: 6mm; right: 6mm;
            border: 2px solid #57534e;
            border-radius: 8px;
            pointer-events: none;
            z-index: 50;
        }
        .sheet-page::after {
            content: "";
            position: absolute;
            top: 7mm; bottom: 7mm; left: 7mm; right: 7mm;
            border: 1px solid #a8a29e;
            border-radius: 6px;
            pointer-events: none;
            z-index: 50;
        }

        @media screen {
            .sheet-page { margin-bottom: 20px; box-shadow: 0 0 20px rgba(0,0,0,0.3); }
        }

        /* Box styles matching the reference */
        .dnd-box {
            border: 2px solid #292929;
            border-radius: 6px;
            background: white;
            position: relative;
        }
        
        .dnd-box-header {
            font-size: 7px;
            text-transform: uppercase;
            font-weight: bold;
            text-align: center;
            padding: 2px;
            background: #e8e8e8;
            border-bottom: 1px solid #292929;
            border-radius: 4px 4px 0 0;
        }

        /* Attribute circle styling */
        .attr-circle {
            width: 42px;
            height: 42px;
            border: 2px solid #292929;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: white;
        }
        
        .attr-score-circle {
            width: 28px;
            height: 18px;
            border: 2px solid #292929;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: white;
            font-size: 10px;
            font-weight: bold;
        }

        /* Diamond checkbox */
        .diamond-check {
            width: 8px;
            height: 8px;
            border: 1.5px solid #292929;
            transform: rotate(45deg);
            display: inline-block;
        }
        .diamond-check.filled {
            background: #292929;
        }

        /* Circle checkbox for spell slots */
        .circle-check {
            width: 10px;
            height: 10px;
            border: 1.5px solid #292929;
            border-radius: 50%;
            display: inline-block;
        }

        /* Input underlines */
        .input-line {
            border-bottom: 1px solid #666;
            min-height: 14px;
        }

        /* Decorative corners */
        .corner-decor::before,
        .corner-decor::after {
            content: '';
            position: absolute;
            width: 8px;
            height: 8px;
            border: 1px solid #666;
        }
        .corner-decor::before {
            top: 3px;
            left: 3px;
            border-right: none;
            border-bottom: none;
        }
        .corner-decor::after {
            top: 3px;
            right: 3px;
            border-left: none;
            border-bottom: none;
        }

    </style>
</head>
<body class="text-gray-900" style="font-size: 8px;">

    {# Print Controls #}
    <div class="no-print fixed top-4 right-4 flex gap-2 z-50">
        <button onclick="window.print()" class="bg-red-800 text-white px-6 py-2 rounded-lg font-bold shadow-lg hover:bg-red-900 transition">
            Imprimir
        </button>
        <button onclick="window.close()" class="bg-white text-gray-700 px-6 py-2 rounded-lg font-bold shadow-lg hover:bg-gray-50">Fechar</button>
    </div>

    {# ==================================================================================== #}
    {# PAGE 1                                                                               #}
    {# ==================================================================================== #}
    <div class="sheet-page page-break p-8 pt-10">
        
        {# Header #}
        <div class="flex justify-between items-start mb-2">
            <div class="w-1/3">
                <div class="font-serif text-2xl font-bold mb-1">{{ character.name|upper }}</div>
                <div style="font-size: 7px;" class="font-bold uppercase text-gray-500">NOME DO PERSONAGEM</div>
            </div>
            <div class="w-2/3 grid grid-cols-3 gap-3">
                <div class="dnd-box p-1">
                    <div class="font-bold text-center" style="font-size: 9px;">{{ character.classDef.name }} {{ character.level }}</div>
                    <div class="text-center uppercase" style="font-size: 6px; color: #666;">CLASSE</div>
                </div>
                <div class="dnd-box p-1">
                    <div class="font-bold text-center" style="font-size: 9px;">{{ character.species.name }}</div>
                    <div class="text-center uppercase" style="font-size: 6px; color: #666;">ESPÉCIE</div>
                </div>
                <div class="dnd-box p-1">
                    <div class="font-bold text-center" style="font-size: 9px;">{{ character.subclassDef.name|default('-') }}</div>
                    <div class="text-center uppercase" style="font-size: 6px; color: #666;">SUBCLASSE</div>
                </div>
            </div>
        </div>

        {# Main Grid: 3 columns #}
        <div class="flex gap-2" style="height: calc(100% - 70px);">
            
            {# LEFT COLUMN: Attributes (2x3 grid) + Equipment #}
            <div class="w-[32%] flex flex-col gap-1.5">
                
                {# Attributes in 2x3 grid #}
                {% set attrs = [
                    ['Força', 'Inteligência'],
                    ['Destreza', 'Sabedoria'],
                    ['Constituição', 'Carisma']
                ] %}
                {% set attr_skills = {
                    'Força': ['Atletismo'],
                    'Destreza': ['Acrobacia', 'Furtividade', 'Prestidigitação'],
                    'Constituição': [],
                    'Inteligência': ['Arcanismo', 'História', 'Investigação', 'Natureza', 'Religião'],
                    'Sabedoria': ['Adestrar Animais', 'Intuição', 'Medicina', 'Percepção', 'Sobrevivência'],
                    'Carisma': ['Atuação', 'Enganação', 'Intimidação', 'Persuasão']
                } %}

                {% for row in attrs %}
                    <div class="grid grid-cols-2 gap-2">
                        {% for attrName in row %}
                            {% set attrEntity = null %}
                            {% for a in character.characterAttributes %}
                                {% if a.attribute.name == attrName %}
                                    {% set attrEntity = a %}
                                {% endif %}
                            {% endfor %}
                            {% set score = attrEntity ? attrEntity.value : 10 %}
                            {% set mod = ((score - 10) / 2)|round(0, 'floor') %}
                            {% set modStr = mod >= 0 ? '+' ~ mod : mod %}

                            <div>
                                {# Attribute box #}
                                <div class="dnd-box p-1.5 flex flex-col items-center">
                                    <div class="dnd-box-header w-full">{{ attrName|upper }}</div>
                                    <div class="attr-circle my-0.5">
                                        <span class="font-serif font-bold" style="font-size: 16px;">{{ modStr }}</span>
                                    </div>
                                    <div class="attr-score-circle mb-1">{{ score }}</div>
                                    
                                    {# Salvaguarda #}
                                    {% set isSave = character.classDef.profSkills is defined and ('Salva: ' ~ attrName) in character.classDef.profSkills %}
                                    <div class="flex items-center gap-1 text-[7px]">
                                        <div class="diamond-check {{ isSave ? 'filled' : '' }}"></div>
                                        <span>Salvaguarda</span>
                                    </div>
                                </div>
                                
                                {# Skills BELOW the attribute box #}
                                {% if attr_skills[attrName] is defined and attr_skills[attrName]|length > 0 %}
                                    <div class="mt-1 space-y-0.5">
                                        {% for skillName in attr_skills[attrName] %}
                                            {% set isProf = false %}
                                            {% for s in character.skills %}
                                                {% if s.name == skillName %}
                                                    {% set isProf = true %}
                                                {% endif %}
                                            {% endfor %}
                                            <div class="flex items-center gap-1" style="font-size: 7px;">
                                                <div class="diamond-check {{ isProf ? 'filled' : '' }}"></div>
                                                <span class="font-semibold">{{ skillName }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}

                {# Proficiency & Inspiration #}
                <div class="grid grid-cols-2 gap-2 mt-1">
                    <div class="dnd-box p-2 flex flex-col items-center">
                        <div class="dnd-box-header w-full">BÔNUS DE PROFICIÊNCIA</div>
                        <div class="font-serif font-bold my-1" style="font-size: 16px;">+2</div>
                    </div>
                    <div class="dnd-box p-2 flex flex-col items-center justify-center">
                        <div class="dnd-box-header w-full">INSPIRAÇÃO HEROICA</div>
                        <div class="circle-check mt-2"></div>
                    </div>
                </div>

                {# Equipment bottom section #}
                <div class="dnd-box p-2 mt-auto">
                    <div class="dnd-box-header">EQUIPAMENTO, TREINO & PROFICIÊNCIAS</div>
                    <div class="mt-1" style="font-size: 6px;">
                        <div class="flex items-center gap-1 mb-1">
                            <span class="font-bold uppercase">ARMADURAS:</span>
                            <div class="diamond-check"></div>
                            <span>Leve</span>
                            <div class="diamond-check"></div>
                            <span>Média</span>
                            <div class="diamond-check"></div>
                            <span>Pesada</span>
                            <div class="diamond-check"></div>
                            <span>Escudos</span>
                        </div>
                        <div class="mb-1">
                            <span class="font-bold uppercase">ARMAS:</span>
                            <div class="input-line mt-0.5"></div>
                        </div>
                        <div>
                            <span class="font-bold uppercase">FERRAMENTAS:</span>
                            <div class="input-line mt-0.5"></div>
                        </div>
                    </div>
                </div>

            </div>

            {# MIDDLE COLUMN: Combat Stats #}
            <div class="w-[38%] flex flex-col gap-1.5">
                
                {# AC, Initiative, Speed #}
                <div class="grid grid-cols-3 gap-2">
                    <div class="dnd-box p-2 flex flex-col items-center">
                        <div class="dnd-box-header w-full">CLASSE DE ARMADURA</div>
                        <div class="font-serif font-bold mt-1" style="font-size: 20px;">15</div>
                    </div>
                    <div class="dnd-box p-2 flex flex-col items-center">
                        <div class="dnd-box-header w-full">INICIATIVA</div>
                        <div class="font-serif font-bold mt-1" style="font-size: 20px;">+2</div>
                    </div>
                    <div class="dnd-box p-2 flex flex-col items-center">
                        <div class="dnd-box-header w-full">VELOCIDADE</div>
                        <div class="font-serif font-bold mt-1" style="font-size: 20px;">9m</div>
                    </div>
                </div>

                {# Tamanho & Passive Perception #}
                <div class="grid grid-cols-2 gap-2">
                    <div class="dnd-box p-2">
                        <div class="dnd-box-header">TAMANHO</div>
                        <div class="text-center mt-1" style="font-size: 9px;">Médio</div>
                    </div>
                    <div class="dnd-box p-2">
                        <div class="dnd-box-header">PERCEPÇÃO PASSIVA</div>
                        <div class="text-center font-bold mt-1" style="font-size: 16px;">10</div>
                    </div>
                </div>

                {# HP Section #}
                <div class="dnd-box p-3">
                    <div class="grid grid-cols-3 gap-2 mb-2">
                        <div class="text-center">
                            <div class="uppercase font-bold" style="font-size: 6px; color: #666;">PONTOS DE VIDA</div>
                            <div class="uppercase font-bold" style="font-size: 6px; color: #666;">ATUAL</div>
                        </div>
                        <div class="text-center">
                            <div class="uppercase font-bold" style="font-size: 6px; color: #666;">DADOS DE VIDA</div>
                            <div class="uppercase font-bold" style="font-size: 6px; color: #666;">TEMP</div>
                        </div>
                        <div class="text-center">
                            <div class="uppercase font-bold" style="font-size: 6px; color: #666;">TESTE DE MORTE</div>
                            <div class="uppercase font-bold" style="font-size: 6px; color: #666;">MAX</div>
                        </div>
                    </div>
                    <div class="grid grid-cols-3 gap-2">
                        <div class="border border-gray-300 p-2 h-12"></div>
                        <div class="border border-gray-300 p-2 h-12"></div>
                        <div class="border border-gray-300 p-2 h-12"></div>
                    </div>
                    
                    {# Death Saves #}
                    <div class="mt-2 flex justify-around" style="font-size: 7px;">
                        <div>
                            <span class="font-bold">SUCESSOS</span>
                            <div class="flex gap-1 mt-1">
                                <div class="circle-check"></div>
                                <div class="circle-check"></div>
                                <div class="circle-check"></div>
                            </div>
                        </div>
                        <div>
                            <span class="font-bold">FALHAS</span>
                            <div class="flex gap-1 mt-1">
                                <div class="circle-check"></div>
                                <div class="circle-check"></div>
                                <div class="circle-check"></div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Attacks & Spellcasting - Large table #}
                <div class="dnd-box p-2 flex-1">
                    <div class="dnd-box-header">ARMAS & TRUQUES DE DANO</div>
                    <table class="w-full mt-2" style="font-size: 7px;">
                        <thead>
                            <tr class="border-b border-gray-400">
                                <th class="text-left font-bold pb-1">Nome</th>
                                <th class="text-center font-bold pb-1">Ataque/CD</th>
                                <th class="text-center font-bold pb-1">Dano & Tipo</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for i in 1..8 %}
                                <tr class="border-b border-gray-200">
                                    <td class="py-1"></td>
                                    <td class="py-1"></td>
                                    <td class="py-1"></td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

            </div>

            {# RIGHT COLUMN: Features #}
            <div class="w-[30%] flex flex-col gap-1.5">
                
                {# Class Features #}
                <div class="dnd-box p-2 flex-1">
                    <div class="dnd-box-header">CARACTERÍSTICAS DE CLASSE</div>
                    <div class="mt-2 space-y-1" style="font-size: 7px;">
                        {% for feature in features|slice(0, 8) %}
                            <div>
                                <div class="font-bold">{{ feature.name }}</div>
                                <div class="text-gray-600">{{ feature.descriptionMd|striptags|slice(0, 60) }}...</div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# Racial Features #}
                <div class="dnd-box p-2" style="height: 90px;">
                    <div class="dnd-box-header">CARACTERÍSTICAS RACIAIS</div>
                    <div class="mt-2" style="font-size: 7px;">
                        {# Species traits to be added when available #}
                    </div>
                </div>

                {# Talents #}
                <div class="dnd-box p-2" style="height: 90px;">
                    <div class="dnd-box-header">TALENTOS</div>
                    <div class="mt-2" style="font-size: 7px;">
                        {% if character.background.feat %}
                            <div class="font-bold">{{ character.background.feat.name }}</div>
                            <div>{{ character.background.feat.descriptionMd|striptags|slice(0, 100) }}</div>
                        {% endif %}
                    </div>
                </div>

            </div>

        </div>

    </div>

    {# ==================================================================================== #}
    {# PAGE 2                                                                               #}
    {# ==================================================================================== #}
    <div class="sheet-page page-break p-8 pt-10">
        
        <div class="flex gap-4 h-full">
            
            {# LEFT COLUMN: Spellcasting (60%) #}
            <div class="w-[60%] flex flex-col gap-3">
                
                {# Spell Stats #}
                <div class="flex gap-2">
                    <div class="dnd-box p-2 flex-1 text-center">
                        <div class="dnd-box-header">ATRIBUTO DE CONJURAÇÃO</div>
                        <div class="font-bold mt-1" style="font-size: 11px;">INT</div>
                    </div>
                    <div class="dnd-box p-2 flex-1 text-center">
                        <div class="dnd-box-header">MODIFICADORES</div>
                        <div class="font-bold mt-1" style="font-size: 11px;">+3</div>
                    </div>
                    <div class="dnd-box p-2 flex-1 text-center">
                        <div class="dnd-box-header">CD DE RESISTÊNCIA DE MAGIA</div>
                        <div class="font-bold mt-1" style="font-size: 11px;">13</div>
                    </div>
                    <div class="dnd-box p-2 flex-1 text-center">
                        <div class="dnd-box-header">BÔNUS DE ATAQUE DE MAGIA</div>
                        <div class="font-bold mt-1" style="font-size: 11px;">+5</div>
                    </div>
                </div>

                {# Spell Slots #}
                <div class="dnd-box p-2">
                    <div class="dnd-box-header">ESPAÇOS DE MAGIA</div>
                    <div class="grid grid-cols-3 gap-x-4 gap-y-1 mt-2" style="font-size: 7px;">
                        {% for level in 1..9 %}
                            <div class="flex items-center gap-2">
                                <span class="font-bold">Nível {{ level }}</span>
                                <div class="flex gap-1">
                                    {% set slots = level <= 3 ? 4 : (level <= 5 ? 3 : 2) %}
                                    {% for i in 1..slots %}
                                        <div class="circle-check"></div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# Spell List Table #}
                <div class="dnd-box p-2 flex-1">
                    <div class="dnd-box-header">TRUQUES & MAGIAS PREPARADAS</div>
                    <table class="w-full mt-2" style="font-size: 6px;">
                        <thead>
                            <tr class="border-b border-gray-400">
                                <th class="text-left font-bold py-1">Nível</th>
                                <th class="text-left font-bold py-1">Nome</th>
                                <th class="text-center font-bold py-1">Conjur.</th>
                                <th class="text-center font-bold py-1">V</th>
                                <th class="text-center font-bold py-1">S</th>
                                <th class="text-center font-bold py-1">M</th>
                                <th class="text-center font-bold py-1">Conc.</th>
                                <th class="text-center font-bold py-1">Ritual</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for spell in character.characterSpells|slice(0, 25) %}
                                <tr class="border-b border-gray-200">
                                    <td class="py-0.5">{{ spell.spell.level }}</td>
                                    <td class="py-0.5">{{ spell.spell.name }}</td>
                                    <td class="text-center"><div class="diamond-check inline-block"></div></td>
                                    <td class="text-center"><div class="diamond-check inline-block"></div></td>
                                    <td class="text-center"><div class="diamond-check inline-block"></div></td>
                                    <td class="text-center"><div class="diamond-check inline-block"></div></td>
                                    <td class="text-center"><div class="diamond-check inline-block"></div></td>
                                    <td class="text-center"><div class="diamond-check inline-block"></div></td>
                                </tr>
                            {% endfor %}
                            {# Empty rows #}
                            {% for i in 1..10 %}
                                <tr class="border-b border-gray-200">
                                    <td class="py-1"></td>
                                    <td></td>
                                    <td class="text-center"><div class="diamond-check inline-block"></div></td>
                                    <td class="text-center"><div class="diamond-check inline-block"></div></td>
                                    <td class="text-center"><div class="diamond-check inline-block"></div></td>
                                    <td class="text-center"><div class="diamond-check inline-block"></div></td>
                                    <td class="text-center"><div class="diamond-check inline-block"></div></td>
                                    <td class="text-center"><div class="diamond-check inline-block"></div></td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

            </div>

            {# RIGHT COLUMN: Character Details (40%) #}
            <div class="w-[40%] flex flex-col gap-3">
                
                {# Appearance/Image #}
                <div class="dnd-box p-2" style="height: 180px;">
                    <div class="dnd-box-header">APARÊNCIA</div>
                    <div class="flex items-center justify-center h-full">
                        {% if character.imagePath %}
                            <img src="{{ vich_uploader_asset(character, 'imageFile') }}" class="max-h-full max-w-full object-contain">
                        {% else %}
                            <span class="text-gray-400" style="font-size: 10px;">Sem imagem</span>
                        {% endif %}
                    </div>
                </div>

                {# History & Personality #}
                <div class="dnd-box p-2 flex-1">
                    <div class="dnd-box-header">HISTÓRIA & PERSONALIDADE</div>
                    <div class="mt-2" style="font-size: 7px; line-height: 1.4;">
                        {{ character.origin|default('...')|slice(0, 600) }}
                    </div>
                </div>

                {# Alignment #}
                <div class="dnd-box p-2">
                    <div class="dnd-box-header">ALINHAMENTO</div>
                    <div class="text-center mt-1" style="font-size: 9px;">{{ character.alignment|default('-') }}</div>
                </div>

                {# Languages #}
                <div class="dnd-box p-2">
                    <div class="dnd-box-header">IDIOMAS</div>
                    <div class="mt-1" style="font-size: 7px;">Comum, Élfico</div>
                </div>

                {# Equipment #}
                <div class="dnd-box p-2" style="height: 120px;">
                    <div class="dnd-box-header">EQUIPAMENTO</div>
                    <div class="mt-2 space-y-0.5" style="font-size: 7px;">
                        {% for item in character.inventory|slice(0, 10) %}
                            <div class="flex justify-between border-b border-gray-200">
                                <span>{{ item.namePt|default(item.name) }}</span>
                                <span class="text-gray-500">{{ item.weightKg }}kg</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# Coins #}
                <div class="dnd-box p-2">
                    <div class="dnd-box-header">MOEDAS</div>
                    <div class="grid grid-cols-5 gap-1 mt-2 text-center" style="font-size: 7px;">
                        <div>
                            <div class="font-bold">PC</div>
                            <div class="border border-gray-300 p-1">{{ character.coinCp }}</div>
                        </div>
                        <div>
                            <div class="font-bold">PP</div>
                            <div class="border border-gray-300 p-1">{{ character.coinSp }}</div>
                        </div>
                        <div>
                            <div class="font-bold">PE</div>
                            <div class="border border-gray-300 p-1">{{ character.coinEp }}</div>
                        </div>
                        <div>
                            <div class="font-bold">PO</div>
                            <div class="border border-gray-300 p-1">{{ character.coinGp }}</div>
                        </div>
                        <div>
                            <div class="font-bold">PL</div>
                            <div class="border border-gray-300 p-1">{{ character.coinPp }}</div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>

</body>
</html>
