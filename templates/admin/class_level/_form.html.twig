{{ form_start(form) }}
    <div class="space-y-6">
        <div class="grid grid-cols-2 gap-4">
            {{ form_row(form.level, {'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-slate-300 dark:border-slate-700'}}) }}
            {{ form_row(form.proficiencyBonus, {'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-slate-300 dark:border-slate-700'}}) }}
        </div>
        
        <div class="grid grid-cols-3 gap-6 p-6 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-100 dark:border-slate-700">
            {{ form_row(form.cantripsKnown, {'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-slate-300 dark:border-slate-700 mb-0'}}) }}
            {{ form_row(form.spellsPrepared, {'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-slate-300 dark:border-slate-700 mb-0'}}) }}
            {{ form_row(form.featsKnown, {'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-purple-500/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-purple-200 dark:border-purple-900/50 mb-0'}}) }}
        </div>
        
        <div class="grid grid-cols-2 gap-6 p-6 bg-indigo-50 dark:bg-indigo-900/20 rounded-2xl border border-indigo-100 dark:border-indigo-800">
            {{ form_row(form.customDie, {'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-indigo-500/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-indigo-200 dark:border-indigo-900/50'}}) }}
            {{ form_row(form.customCount, {'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-indigo-500/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-indigo-200 dark:border-indigo-900/50'}}) }}
        </div>

        {{ form_row(form.featuresList, {'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-slate-300 dark:border-slate-700', 'rows': 2}}) }}

        {{ form_row(form.spellSlotsJson, {'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-slate-300 dark:border-slate-700 font-mono text-sm', 'rows': 3}}) }}
        {{ form_row(form.featuresConfig, {'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-slate-300 dark:border-slate-700 font-mono text-sm', 'rows': 3}}) }}
        
        <div class="pt-4 flex items-center justify-end">
            <button class="bg-primary text-white px-6 py-3 rounded-2xl font-bold hover:bg-primary/90 transition-all">
                {{ button_label|default('Salvar') }}
            </button>
        </div>
    </div>
{{ form_end(form) }}
