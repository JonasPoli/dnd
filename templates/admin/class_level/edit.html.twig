{% extends 'base_admin.html.twig' %}

{% block title %}Editar Nível {{ class_level.level }} - {{ class_def.name }}{% endblock %}

{% block body %}
    <div class="mb-8 flex items-center justify-between">
        <div>
            <a href="{{ path('admin_class_level_index', {'id': class_def.id}) }}" class="inline-flex items-center text-sm font-bold text-slate-400 hover:text-primary transition-colors mb-4">
                {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4 mr-2'}) }}
                Voltar para Níveis
            </a>
            <h1 class="text-2xl font-bold dark:text-white">Editar Nível {{ class_level.level }}</h1>
            <p class="text-slate-500 text-sm">Classe: {{ class_def.name }}</p>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-border p-8 shadow-sm max-w-2xl">
        {{ include('admin/class_level/_form.html.twig', {'button_label': 'Salvar Alterações'}) }}
    </div>
{% endblock %}
