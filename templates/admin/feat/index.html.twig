{% extends 'base_admin.html.twig' %}

{% block header_title %}Talentos{% endblock %}

{% block body %}
<div class="mb-8 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold dark:text-white">Galeria de Talentos</h1>
        <p class="text-slate-500 text-sm">Gerencie os talentos e habilidades especiais dos personagens.</p>
    </div>
    <a href="{{ path('admin_feat_new') }}" class="bg-primary text-white px-6 py-3 rounded-2xl font-bold shadow-lg shadow-primary/25 hover:bg-primary/90 transition-all flex items-center space-x-2">
        {{ ux_icon('lucide:plus', {class: 'w-5 h-5'}) }}
        <span>Novo Talento</span>
    </a>
</div>

<div class="bg-white dark:bg-slate-900 rounded-3xl border border-border overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="bg-slate-50 dark:bg-slate-800/50 border-b border-border">
                    <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400">Nome</th>
                    <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400">Tipo</th>
                    <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400">Pré-requisito</th>
                    <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400 text-right">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border">
                {% for feat in feats %}
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                        <td class="px-8 py-5">
                            <div class="font-bold text-slate-900 dark:text-white">{{ feat.name }}</div>
                        </td>
                        <td class="px-8 py-5">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-secondary/10 text-secondary">
                                {{ feat.type|default('-') }}
                            </span>
                        </td>
                        <td class="px-8 py-5">
                            <span class="text-sm italic text-slate-600 dark:text-slate-400">{{ feat.prerequisite|default('Nenhum')|u.truncate(50, '...') }}</span>
                        </td>
                        <td class="px-8 py-5 text-right">
                            <div class="flex items-center justify-end space-x-3">
                                <a href="{{ path('admin_feat_edit', {'id': feat.id}) }}" class="p-2 bg-slate-100 dark:bg-slate-800 rounded-xl text-slate-500 hover:text-primary transition-colors">
                                    {{ ux_icon('lucide:edit-3', {class: 'w-5 h-5'}) }}
                                </a>
                                {{ include('admin/feat/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="px-8 py-12 text-center text-slate-400">
                            Nenhum talento encontrado.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="px-8 py-5 border-t border-border flex items-center justify-between bg-slate-50/50 dark:bg-slate-800/30">
        <div class="text-sm text-slate-500 dark:text-slate-400">
            Mostrando <span class="font-medium text-slate-900 dark:text-white">{{ (current_page - 1) * 20 + 1 }}</span> a <span class="font-medium text-slate-900 dark:text-white">{{ min(current_page * 20, total_items) }}</span> de <span class="font-medium text-slate-900 dark:text-white">{{ total_items }}</span> resultados
        </div>
        
        {% if total_pages > 1 %}
        <div class="flex items-center space-x-2">
            {% if current_page > 1 %}
                <a href="{{ path('admin_feat_index', {'page': current_page - 1, 'search': search}) }}" class="px-3 py-1 text-sm font-medium text-slate-700 bg-white dark:bg-slate-800 dark:text-slate-200 border border-slate-300 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
                    Anterior
                </a>
            {% else %}
                <span class="px-3 py-1 text-sm font-medium text-slate-400 bg-slate-100 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-lg cursor-not-allowed">
                    Anterior
                </span>
            {% endif %}

            <div class="flex items-center space-x-1">
                {% for i in max(1, current_page - 2)..min(total_pages, current_page + 2) %}
                    <a href="{{ path('admin_feat_index', {'page': i, 'search': search}) }}" class="px-3 py-1 text-sm font-medium rounded-lg transition-colors {{ current_page == i ? 'bg-primary text-white border border-primary' : 'text-slate-700 bg-white dark:bg-slate-800 dark:text-slate-200 border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700' }}">
                        {{ i }}
                    </a>
                {% endfor %}
            </div>

            {% if current_page < total_pages %}
                <a href="{{ path('admin_feat_index', {'page': current_page + 1, 'search': search}) }}" class="px-3 py-1 text-sm font-medium text-slate-700 bg-white dark:bg-slate-800 dark:text-slate-200 border border-slate-300 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
                    Próxima
                </a>
            {% else %}
                <span class="px-3 py-1 text-sm font-medium text-slate-400 bg-slate-100 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-lg cursor-not-allowed">
                    Próxima
                </span>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
