{% extends 'base_admin.html.twig' %}

{% block header_title %}Detalhes do Termo{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <a href="{{ path('app_admin_glossary_index') }}" class="text-slate-400 hover:text-primary transition-colors flex items-center space-x-2 text-sm font-bold uppercase tracking-widest">
                {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4'}) }}
                <span>Voltar para Lista</span>
            </a>
            <div class="flex items-center gap-3 mt-4">
                <h1 class="text-3xl font-bold dark:text-white">{{ glossary.name }}</h1>
                <span class="px-2 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-500 text-xs font-mono">ID: {{ glossary.id }}</span>
            </div>
        </div>
        
        <div class="flex items-center space-x-3">
            <a href="{{ path('app_admin_glossary_edit', {'id': glossary.id}) }}" class="bg-primary text-white px-6 py-2.5 rounded-xl font-bold shadow-lg shadow-primary/25 hover:bg-primary/90 transition-all flex items-center space-x-2">
                {{ ux_icon('lucide:edit-3', {class: 'w-4 h-4'}) }}
                <span>Editar</span>
            </a>
            {{ include('admin/glossary/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-border overflow-hidden shadow-sm">
        <div class="p-8">
            <h3 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">Descrição</h3>
            <div class="prose prose-slate dark:prose-invert max-w-none">
                <p>{{ glossary.description|nl2br }}</p>
            </div>
        </div>
    </div>

</div>
{% endblock %}
