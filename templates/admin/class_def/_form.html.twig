{{ form_start(form, {'attr': {'data-turbo': 'false'}}) }}
    <div class="space-y-6">
        {% if not form.vars.valid %}
            <div class="bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 p-4 rounded-2xl border border-red-100 dark:border-red-900/50 mb-6">
                <div class="font-bold flex items-center mb-2">
                    {{ ux_icon('lucide:alert-circle', {class: 'w-5 h-5 mr-2'}) }}
                    Erros no formulário
                </div>
                <ul class="list-disc list-inside text-sm space-y-1">
                    {# Global errors #}
                    {% for error in form.vars.errors %}
                        <li>{{ error.message }}</li>
                    {% endfor %}
                    
                    {# Field errors #}
                    {% for child in form %}
                        {% for error in child.vars.errors %}
                            <li><strong>{{ child.vars.label|default(child.vars.name) }}:</strong> {{ error.message }}</li>
                        {% endfor %}
                    {% endfor %}

                    {# Check for errors in collection items #}
                    {% if form.classLevels is defined %}
                        {% for levelForm in form.classLevels %}
                            {% if not levelForm.vars.valid %}
                                <li>
                                    <strong>Nível {{ levelForm.vars.value.level|default('?') }}:</strong>
                                    <ul class="list-circle list-inside ml-4 mt-1">
                                        {% for error in levelForm.vars.errors %}
                                            <li>{{ error.message }}</li>
                                        {% endfor %}
                                        {% for levelChild in levelForm %}
                                            {% for error in levelChild.vars.errors %}
                                                <li>{{ levelChild.vars.label|default(levelChild.vars.name) }}: {{ error.message }}</li>
                                            {% endfor %}
                                        {% endfor %}
                                    </ul>
                                </li>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                </ul>
            </div>
        {% endif %}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                {{ form_row(form.name, {
                    'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                    'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                }) }}
            </div>
            </div>
            <div>
                 {% if vich_uploader_asset(form.vars.data, 'logoFile') %}
                    <div class="mb-2">
                        <img src="{{ vich_uploader_asset(form.vars.data, 'logoFile') }}" alt="Current Logo" class="h-20 w-auto object-contain rounded-lg border border-slate-200 dark:border-slate-700 bg-white p-1">
                    </div>
                 {% endif %}
                 {{ form_row(form.logoFile, {
                    'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                    'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                }) }}
            </div>
            <div>
                {{ form_row(form.ruleSlug, {
                    'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                    'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                }) }}
            </div>
        </div>

        {# Creation Characteristics Section #}
        <div class="space-y-6 mt-8">
            <h3 class="font-bold text-lg text-slate-700 dark:text-slate-200 border-b pb-2 flex items-center gap-2">
                {{ ux_icon('lucide:settings', {class: 'w-5 h-5'}) }}
                Características de Criação
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {# Column 1: Core Definitions #}
                <div class="space-y-4 bg-slate-50 dark:bg-slate-900/50 p-4 rounded-2xl border border-slate-100 dark:border-slate-800">
                    <h4 class="font-bold text-xs uppercase tracking-wider text-slate-500 mb-2">Definições Básicas</h4>
                    {{ form_row(form.hitDie, {'label_attr': {'class': 'form-label-sm'}, 'attr': {'class': 'form-input'}}) }}
                    {{ form_row(form.subtypesName, {'label_attr': {'class': 'form-label-sm'}, 'attr': {'class': 'form-input'}}) }}
                    {{ form_row(form.spellcastingAbility, {'label_attr': {'class': 'form-label-sm'}, 'attr': {'class': 'form-input'}}) }}
                </div>

                {# Column 2: Initial proficiencies count #}
                <div class="space-y-4 bg-indigo-50 dark:bg-indigo-900/20 p-4 rounded-2xl border border-indigo-100 dark:border-indigo-800">
                     <h4 class="font-bold text-xs uppercase tracking-wider text-indigo-500 mb-2">Quantidades Iniciais</h4>
                     {{ form_row(form.initialSkillsCount, {'label_attr': {'class': 'form-label-sm'}, 'attr': {'class': 'form-input'}}) }}
                     {{ form_row(form.initialToolsCount, {'label_attr': {'class': 'form-label-sm'}, 'attr': {'class': 'form-input'}}) }}
                </div>

                {# Column 3: Source #}
                <div class="space-y-4 bg-emerald-50 dark:bg-emerald-900/20 p-4 rounded-2xl border border-emerald-100 dark:border-emerald-800">
                    <h4 class="font-bold text-xs uppercase tracking-wider text-emerald-500 mb-2">Fonte</h4>
                    {{ form_row(form.rulesSource, {'label_attr': {'class': 'form-label-sm'}, 'attr': {'class': 'form-input'}}) }}
                </div>
            </div>

            {# Attributes & Saves #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-700">
                    <h4 class="font-bold text-sm text-slate-700 dark:text-slate-200 mb-4 flex items-center gap-2">
                        {{ ux_icon('lucide:star', {class: 'w-4 h-4 text-amber-500'}) }} Atributos Primários
                    </h4>
                    <div class="grid grid-cols-2 gap-4">
                        {{ form_row(form.primaryAbility1, {'label_attr': {'class': 'form-label-sm'}, 'attr': {'class': 'form-select-sm'}}) }}
                        {{ form_row(form.primaryAbility2, {'label_attr': {'class': 'form-label-sm'}, 'attr': {'class': 'form-select-sm'}}) }}
                    </div>
                </div>

                <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-700">
                    <h4 class="font-bold text-sm text-slate-700 dark:text-slate-200 mb-4 flex items-center gap-2">
                        {{ ux_icon('lucide:shield', {class: 'w-4 h-4 text-green-500'}) }} Salvaguardas
                    </h4>
                    <div class="grid grid-cols-2 gap-4">
                        {{ form_row(form.savingThrow1, {'label_attr': {'class': 'form-label-sm'}, 'attr': {'class': 'form-select-sm'}}) }}
                        {{ form_row(form.savingThrow2, {'label_attr': {'class': 'form-label-sm'}, 'attr': {'class': 'form-select-sm'}}) }}
                    </div>
                </div>
            </div>

            {# Proficiencies #}
            <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-700">
                <h4 class="font-bold text-sm text-slate-700 dark:text-slate-200 mb-4 flex items-center gap-2">
                    {{ ux_icon('lucide:sword', {class: 'w-4 h-4 text-red-500'}) }} Proficiências de Combate & Ferramentas
                </h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-4">
                        {{ form_row(form.weaponProficiencies, {'label_attr': {'class': 'form-label-sm'}, 'attr': {'class': 'form-select'}}) }}
                        {{ form_row(form.armorTraining, {'label_attr': {'class': 'form-label-sm'}, 'attr': {'class': 'form-select'}}) }}
                    </div>
                    <div class="space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            {{ form_row(form.toolProficiency1, {'label_attr': {'class': 'form-label-sm'}, 'attr': {'class': 'form-select'}}) }}
                            {{ form_row(form.toolProficiency2, {'label_attr': {'class': 'form-label-sm'}, 'attr': {'class': 'form-select'}}) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-slate-100 dark:bg-slate-900 rounded-2xl p-4 mt-6 border border-slate-200 dark:border-slate-800 opacity-75 hover:opacity-100 transition-opacity">
            <h5 class="font-bold text-xs uppercase tracking-wider text-slate-500 mb-4 flex items-center gap-2">
                {{ ux_icon('lucide:database', {class: 'w-4 h-4'}) }} Dados Legados (JSON)
            </h5>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {{ form_row(form.primaryAbilities, {
                    'label_attr': {'class': 'form-label-xs'},
                    'attr': {'class': 'form-textarea-sm font-mono', 'rows': 3}
                }) }}
                {{ form_row(form.savingThrowProficiencies, {
                    'label_attr': {'class': 'form-label-xs'},
                    'attr': {'class': 'form-textarea-sm font-mono', 'rows': 3}
                }) }}
            </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
            <div>
                {{ form_row(form.hpAt1stLevel, {
                    'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                    'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                }) }}
            </div>
            <div>
                 {{ form_row(form.hpAtHigherLevels, {
                    'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                    'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                }) }}
            </div>
        </div>
        
        <div class="space-y-6 mt-6">
            <h3 class="font-bold text-lg text-slate-700 dark:text-slate-200 border-b pb-2">Proficiências e Equipamento</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {{ form_row(form.profArmor, {'attr': {'class': 'form-textarea block w-full rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800', 'rows': 3}}) }}
                {{ form_row(form.profWeapons, {'attr': {'class': 'form-textarea block w-full rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800', 'rows': 3}}) }}
                {{ form_row(form.profTools, {'attr': {'class': 'form-textarea block w-full rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800', 'rows': 3}}) }}
                {{ form_row(form.profSkills, {'attr': {'class': 'form-textarea block w-full rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800', 'rows': 3}}) }}
            </div>
            
            {{ form_row(form.equipment, {'attr': {'class': 'form-textarea block w-full rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800', 'rows': 4}}) }}
        </div>



        <div class="space-y-6 mt-6">
             <h3 class="font-bold text-lg text-slate-700 dark:text-slate-200 border-b pb-2">Detalhes</h3>
            {{ form_row(form.characterCreationHelp, {
                'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700', 'rows': 6}
            }) }}

            {{ form_row(form.descriptionMd, {
                'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700', 'rows': 6}
            }) }}
            
            {{ form_row(form.classTableMd, {
                'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700 font-mono text-xs', 'rows': 10}
            }) }}
        </div>
    </div>

    <div class="mt-10 flex items-center space-x-4">
        <button class="bg-primary text-white px-8 py-4 rounded-2xl font-bold shadow-lg shadow-primary/25 hover:bg-primary/90 hover:scale-[1.02] active:scale-[0.98] transition-all">
            {{ button_label|default('Salvar Classe') }}
        </button>
        <a href="{{ path('admin_class_index') }}" class="px-8 py-4 rounded-2xl font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
            Cancelar
        </a>
    </div>
{{ form_end(form) }}
