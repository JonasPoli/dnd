{% extends 'base_admin.html.twig' %}

{% block header_title %}Adicionar Magia à Subclasse{% endblock %}

{% block body %}
<div class="mb-8">
    <a href="{{ path('admin_subclass_edit', {'id': subclass.id}) }}" class="inline-flex items-center text-sm font-bold text-slate-400 hover:text-primary transition-colors mb-4">
        {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4 mr-2'}) }}
        Voltar para a Subclasse
    </a>
    <h1 class="text-2xl font-bold dark:text-white">Adicionar Magia: {{ subclass.name }}</h1>
    <p class="text-slate-500 text-sm">Adicione uma magia que será sempre preparada para esta subclasse.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Form Section -->
    <div class="lg:col-span-2">
        <div class="bg-white dark:bg-slate-900 rounded-3xl border border-border p-8 shadow-sm">
            {{ form_start(form) }}
                <div class="space-y-6">
                    {% if not form.vars.valid %}
                        <div class="bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 p-4 rounded-2xl border border-red-100 dark:border-red-900/50 mb-6">
                            <ul class="list-disc list-inside text-sm">
                                {% for error in form.vars.errors %}
                                    <li>{{ error.message }}</li>
                                {% endfor %}
                                {% for child in form %}
                                    {% for error in child.vars.errors %}
                                        <li>{{ error.message }}</li>
                                    {% endfor %}
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    <div class="grid grid-cols-1 md:grid-cols-6 gap-6">
                        <div class="md:col-span-1">
                            {{ form_row(form.levelAcquired, {
                                'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                                'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700 text-center'}
                            }) }}
                        </div>
                        <div class="md:col-span-5">
                            {{ form_row(form.spell, {
                                'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                                'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                            }) }}
                        </div>
                    </div>

                    <div class="flex items-center gap-4 mt-8">
                        <button class="bg-primary text-white px-6 py-3 rounded-xl font-bold shadow-lg shadow-primary/25 hover:bg-primary/90 transition-all">
                            Adicionar Magia
                        </button>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    <!-- Existing Spells List Section -->
    <div class="lg:col-span-1">
        <div class="bg-slate-50 dark:bg-slate-900/50 rounded-3xl border border-border p-6">
            <h3 class="font-bold text-lg text-slate-700 dark:text-slate-200 mb-4 flex items-center gap-2">
                {{ ux_icon('lucide:list', {class: 'w-5 h-5'}) }}
                Magias Já Adicionadas
            </h3>
            
            <div class="space-y-2">
                {% for spell in subclass.subclassSpells %}
                    <div class="bg-white dark:bg-slate-800 p-3 rounded-xl border border-slate-200 dark:border-slate-700 flex items-center justify-between">
                        <div>
                            <span class="text-xs font-bold text-primary bg-primary/10 px-2 py-1 rounded-md mr-2">
                                Nvl {{ spell.levelAcquired }}
                            </span>
                            <span class="font-medium text-slate-700 dark:text-slate-200 block">
                                {{ spell.spell.namePt|default(spell.spell.name) }}
                            </span>
                            {% if spell.spell.namePt and spell.spell.name != spell.spell.namePt %}
                                <span class="text-xs text-slate-400 italic block">{{ spell.spell.name }}</span>
                            {% endif %}
                        </div>
                        
                        <form method="post" action="{{ path('admin_subclass_spell_delete', {'id': spell.id}) }}" onsubmit="return confirm('Tem certeza que deseja remover esta magia da subclasse?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ spell.id) }}">
                            <button class="text-red-400 hover:text-red-600 transition-colors p-1 hover:bg-red-50 dark:hover:bg-red-900/20 rounded" title="Remover Magia">
                                {{ ux_icon('lucide:trash-2', {class: 'w-4 h-4'}) }}
                            </button>
                        </form>
                    </div>
                {% else %}
                    <p class="text-slate-400 text-sm italic text-center py-4">Nenhuma magia adicionada ainda.</p>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
