{% extends 'base_admin.html.twig' %}

{% block header_title %}Editar Magia da Subclasse{% endblock %}

{% block body %}
<div class="mb-8">
    <a href="{{ path('admin_subclass_edit', {'id': subclass.id}) }}" class="inline-flex items-center text-sm font-bold text-slate-400 hover:text-primary transition-colors mb-4">
        {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4 mr-2'}) }}
        Voltar para a Subclasse
    </a>
    <h1 class="text-2xl font-bold dark:text-white">Editar Magia: {{ subclass.name }}</h1>
</div>

<div class="bg-white dark:bg-slate-900 rounded-3xl border border-border p-8 shadow-sm max-w-2xl">
    {{ form_start(form) }}
        <div class="space-y-6">
            {% if not form.vars.valid %}
                <div class="bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 p-4 rounded-2xl border border-red-100 dark:border-red-900/50 mb-6">
                    <ul class="list-disc list-inside text-sm">
                        {% for error in form.vars.errors %}
                            <li>{{ error.message }}</li>
                        {% endfor %}
                        {% for child in form %}
                            {% for error in child.vars.errors %}
                                <li>{{ error.message }}</li>
                            {% endfor %}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div class="md:col-span-1">
                    {{ form_row(form.levelAcquired, {
                        'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                        'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700 text-center'}
                    }) }}
                </div>
                <div class="md:col-span-3">
                    {{ form_row(form.spell, {
                        'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                        'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                    }) }}
                </div>
            </div>

            <div class="flex items-center gap-4 mt-8">
                <button class="bg-primary text-white px-6 py-3 rounded-xl font-bold shadow-lg shadow-primary/25 hover:bg-primary/90 transition-all">
                    Salvar Alterações
                </button>
            </div>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
