{{ form_start(form) }}
    <div class="space-y-6">
        {% if not form.vars.valid %}
            <div class="bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 p-4 rounded-2xl border border-red-100 dark:border-red-900/50 mb-6">
                <div class="font-bold flex items-center mb-2">
                    {{ ux_icon('lucide:alert-circle', {class: 'w-5 h-5 mr-2'}) }}
                    Erros no formulário
                </div>
                <ul class="list-disc list-inside text-sm space-y-1">
                    {# Global errors #}
                    {% for error in form.vars.errors %}
                        <li>{{ error.message }}</li>
                    {% endfor %}
                    
                    {# Field errors #}
                    {% for child in form %}
                        {% for error in child.vars.errors %}
                            <li><strong>{{ child.vars.label|default(child.vars.name) }}:</strong> {{ error.message }}</li>
                        {% endfor %}
                    {% endfor %}

                    {# Check for errors in collection items #}
                    {% if form.subclassSpells is defined %}
                        {% for spellForm in form.subclassSpells %}
                            {% if not spellForm.vars.valid %}
                                <li>
                                    <strong>Magia #{{ loop.index }}:</strong>
                                    <ul class="list-circle list-inside ml-4 mt-1">
                                        {% for error in spellForm.vars.errors %}
                                            <li>{{ error.message }}</li>
                                        {% endfor %}
                                        {% for spellChild in spellForm %}
                                            {% for error in spellChild.vars.errors %}
                                                <li>{{ spellChild.vars.label|default(spellChild.vars.name) }}: {{ error.message }}</li>
                                            {% endfor %}
                                        {% endfor %}
                                    </ul>
                                </li>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                </ul>
            </div>
        {% endif %}
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                {{ form_row(form.name, {
                    'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                    'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                }) }}
            </div>
            <div>
                {{ form_row(form.ruleSlug, {
                    'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                    'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                }) }}
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                {{ form_row(form.classDef, {
                    'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                    'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                }) }}
            </div>
            <div>
                {{ form_row(form.availableFromLevel, {
                    'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                    'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700', 'min': 1, 'max': 20}
                }) }}
            </div>
            <div>
                {{ form_row(form.rulesSource, {
                    'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                    'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                }) }}
            </div>
        </div>

        <div class="mt-6">
            {{ form_row(form.descriptionMd, {
                'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700', 'rows': 6}
            }) }}
        </div>
        <div class="space-y-6 mt-8">
            <h3 class="font-bold text-lg text-slate-700 dark:text-slate-200 border-b pb-2 flex items-center gap-2">
                {{ ux_icon('lucide:scroll', {class: 'w-5 h-5'}) }}
                Magias Sempre Preparadas
            </h3>
            
            <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-700">
                
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="text-xs text-slate-500 uppercase bg-slate-50 dark:bg-slate-700/50">
                            <tr>
                                <th class="px-3 py-2 w-24">Nível</th>
                                <th class="px-3 py-2">Magia</th>
                                <th class="px-3 py-2 w-32 text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                            {% for spell in form.vars.value.subclassSpells %}
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors">
                                    <td class="px-3 py-2 font-medium">
                                        {{ spell.levelAcquired }}
                                    </td>
                                    <td class="px-3 py-2">
                                        <div class="font-medium text-slate-900 dark:text-white">
                                            {{ spell.spell.namePt|default(spell.spell.name) }}
                                        </div>
                                        {% if spell.spell.namePt and spell.spell.name != spell.spell.namePt %}
                                            <div class="text-xs text-slate-400 italic">({{ spell.spell.name }})</div>
                                        {% endif %}
                                        <div class="text-xs text-slate-500 mt-1">Nível {{ spell.spell.level }}</div>
                                    </td>
                                    <td class="px-3 py-2 flex items-center justify-center gap-2">
                                        <a href="{{ path('admin_subclass_spell_edit', {'id': spell.id}) }}" 
                                           class="text-slate-400 hover:text-primary transition-colors p-1 hover:bg-slate-100 dark:hover:bg-slate-800 rounded"
                                           title="Editar Magia">
                                            {{ ux_icon('lucide:edit-2', {class: 'w-4 h-4'}) }}
                                        </a>
                                        
                                        <form method="post" action="{{ path('admin_subclass_spell_delete', {'id': spell.id}) }}" onsubmit="return confirm('Tem certeza que deseja remover esta magia da subclasse?');" class="inline-block">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ spell.id) }}">
                                            <button class="text-red-400 hover:text-red-600 transition-colors p-1 hover:bg-red-50 dark:hover:bg-red-900/20 rounded"
                                                    title="Remover Magia">
                                                {{ ux_icon('lucide:trash-2', {class: 'w-4 h-4'}) }}
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="3" class="px-3 py-8 text-center text-slate-400 italic">
                                        Nenhuma magia cadastrada para esta subclasse.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                <div class="mt-4 pt-4 border-t border-slate-200 dark:border-slate-700">
                    <a href="{{ path('admin_subclass_spell_new', {'id': form.vars.value.id}) }}" 
                       class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary/80 transition-colors">
                        {{ ux_icon('lucide:plus-circle', {class: 'w-5 h-5'}) }}
                        Adicionar Magia
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-10 flex items-center space-x-4">
        <button class="bg-primary text-white px-8 py-4 rounded-2xl font-bold shadow-lg shadow-primary/25 hover:bg-primary/90 hover:scale-[1.02] active:scale-[0.98] transition-all">
            {{ button_label|default('Salvar Subclasse') }}
        </button>
        <a href="{{ path('admin_subclass_index') }}" class="px-8 py-4 rounded-2xl font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
            Cancelar
        </a>
    </div>
{{ form_end(form) }}
