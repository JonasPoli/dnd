{{ form_start(form) }}
    <div class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                {{ form_row(form.name, {
                    'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                    'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                }) }}
            </div>
            <div>
                {{ form_row(form.ruleSlug, {
                    'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                    'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                }) }}
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                {{ form_row(form.classDef, {
                    'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                    'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                }) }}
            </div>
            <div>
                {{ form_row(form.availableFromLevel, {
                    'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                    'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700', 'min': 1, 'max': 20}
                }) }}
            </div>
            <div>
                {{ form_row(form.rulesSource, {
                    'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                    'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                }) }}
            </div>
        </div>

        </div>

        <div class="space-y-6 mt-6">
            <h3 class="font-bold text-lg text-slate-700 dark:text-slate-200 border-b pb-2">Always Prepared Spells</h3>
            <div data-controller="form-collection"
                 data-form-collection-prototype-value="{{ form_widget(form.subclassSpells.vars.prototype)|e('html_attr') }}"
                 data-form-collection-index-value="{{ form.subclassSpells|length }}"
                 class="space-y-4">
                
                <div data-form-collection-target="collection" class="space-y-2">
                    {% for spellForm in form.subclassSpells %}
                        <div class="flex items-center gap-4 bg-white dark:bg-slate-800 p-3 rounded-xl border border-slate-200 dark:border-slate-700">
                             {{ form_widget(spellForm.levelAcquired) }}
                             <div class="flex-1">
                                {{ form_widget(spellForm.spell) }}
                             </div>
                             <button type="button" data-action="form-collection#remove" class="text-red-500 hover:text-red-700 p-2">
                                {{ ux_icon('lucide:trash-2', {class: 'w-4 h-4'}) }}
                             </button>
                        </div>
                    {% endfor %}
                </div>

                <button type="button" data-action="form-collection#add" class="text-xs font-bold uppercase tracking-widest text-primary hover:text-primary/80 flex items-center">
                    {{ ux_icon('lucide:plus', {class: 'w-4 h-4 mr-2'}) }} Add Spell
                </button>
            </div>
        </div>
    </div>

    <div class="mt-10 flex items-center space-x-4">
        <button class="bg-primary text-white px-8 py-4 rounded-2xl font-bold shadow-lg shadow-primary/25 hover:bg-primary/90 hover:scale-[1.02] active:scale-[0.98] transition-all">
            {{ button_label|default('Salvar Subclasse') }}
        </button>
        <a href="{{ path('admin_subclass_index') }}" class="px-8 py-4 rounded-2xl font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
            Cancelar
        </a>
    </div>
{{ form_end(form) }}
