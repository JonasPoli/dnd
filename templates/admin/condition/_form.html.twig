{{ form_start(form) }}
    <div class="space-y-6">
        {# Metadata Section #}
        <div class="bg-slate-50 dark:bg-slate-800/50 p-4 rounded-2xl border border-slate-200 dark:border-slate-700">
            <h3 class="text-sm font-bold uppercase tracking-widest text-slate-500 mb-4 flex items-center gap-2">
                {{ ux_icon('lucide:settings', {class: 'w-4 h-4'}) }}
                Metadados
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                     {{ form_row(form.rulesSource, {
                        'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                        'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                    }) }}
                </div>
                <div>
                    {{ form_row(form.ruleSlug, {
                        'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                        'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                    }) }}
                </div>
            </div>
        </div>

        {# Content Section #}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            {# Original #}
            <div class="space-y-6">
                <div class="flex items-center space-x-2 text-slate-400 font-bold uppercase text-xs tracking-widest border-b border-slate-200 dark:border-slate-700 pb-2 mb-4">
                    <span class="text-xl">🇺🇸</span>
                    <span>Original (English)</span>
                </div>
                
                <div>
                    {{ form_row(form.name, {
                        'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                        'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700'}
                    }) }}
                </div>
                 <div>
                    {{ form_row(form.descriptionMd, {
                        'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                        'attr': {'class': 'font-mono text-sm block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-slate-400 dark:border-slate-700', 'rows': 20}
                    }) }}
                </div>
            </div>

            {# Translation #}
            <div class="space-y-6">
                <div class="flex items-center space-x-2 text-primary font-bold uppercase text-xs tracking-widest border-b border-primary/30 pb-2 mb-4">
                    <span class="text-xl">🇧🇷</span>
                    <span>Tradução (Português)</span>
                </div>
                
                <div>
                    {{ form_row(form.namePt, {
                        'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                        'attr': {'class': 'block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-primary/50 dark:border-primary/50'}
                    }) }}
                </div>
                 <div>
                    {{ form_row(form.descriptionMdPt, {
                        'label_attr': {'class': 'block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 ml-1'},
                        'attr': {'class': 'font-mono text-sm block w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white dark:focus:bg-slate-700 transition-all outline-none border-2 border-primary/50 dark:border-primary/50', 'rows': 20}
                    }) }}
                </div>
            </div>
        </div>
    </div>

    <div class="mt-10 flex items-center space-x-4">
        <button class="bg-primary text-white px-8 py-4 rounded-2xl font-bold shadow-lg shadow-primary/25 hover:bg-primary/90 hover:scale-[1.02] active:scale-[0.98] transition-all">
            {{ button_label|default('Salvar Condição') }}
        </button>
        <a href="{{ path('admin_condition_index') }}" class="px-8 py-4 rounded-2xl font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
            Cancelar
        </a>
    </div>
{{ form_end(form) }}
