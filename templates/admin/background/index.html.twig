{% extends 'base_admin.html.twig' %}

{% block header_title %}Antecedentes{% endblock %}

{% block body %}
<div class="mb-8 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold dark:text-white">Antecedentes (Backgrounds)</h1>
        <p class="text-slate-500 text-sm">Gerencie a origem e história pregressa dos personagens.</p>
    </div>
    <a href="{{ path('admin_background_new') }}" class="bg-primary text-white px-6 py-3 rounded-2xl font-bold shadow-lg shadow-primary/25 hover:bg-primary/90 transition-all flex items-center space-x-2">
        {{ ux_icon('lucide:plus', {class: 'w-5 h-5'}) }}
        <span>Novo Antecedente</span>
    </a>
</div>

<div class="bg-white dark:bg-slate-900 rounded-3xl border border-border overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="bg-slate-50 dark:bg-slate-800/50 border-b border-border">
                    <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400">Nome</th>
                    <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400">Atributos</th>
                    <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400">Talento</th>
                    <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400">Perícias</th>
                    <th class="px-8 py-5 text-[10px] font-bold uppercase tracking-widest text-slate-400 text-right">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border">
                {% for background in backgrounds %}
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                        <td class="px-8 py-5">
                            <div class="font-bold text-slate-900 dark:text-white">{{ background.name }}</div>
                        </td>
                        <td class="px-8 py-5">
                            <div class="flex gap-1 text-xs text-slate-500">
                                {% if background.attribute1 %}<span class="bg-slate-100 dark:bg-slate-800 px-2 py-1 rounded">{{ background.attribute1.name }}</span>{% endif %}
                                {% if background.attribute2 %}<span class="bg-slate-100 dark:bg-slate-800 px-2 py-1 rounded">{{ background.attribute2.name }}</span>{% endif %}
                                {% if background.attribute3 %}<span class="bg-slate-100 dark:bg-slate-800 px-2 py-1 rounded">{{ background.attribute3.name }}</span>{% endif %}
                            </div>
                        </td>
                         <td class="px-8 py-5">
                            {% if background.feat %}
                                <span class="text-sm text-indigo-600 dark:text-indigo-400 font-medium">{{ background.feat.name }}</span>
                            {% else %}
                                <span class="text-slate-400">-</span>
                            {% endif %}
                        </td>
                        <td class="px-8 py-5">
                             <div class="flex flex-wrap gap-1 text-xs">
                                {% if background.skill1 %}<span class="text-slate-600 dark:text-slate-300">{{ background.skill1.name }}</span>{% endif %}
                                {% if background.skill2 %}<span class="text-slate-600 dark:text-slate-300">, {{ background.skill2.name }}</span>{% endif %}
                             </div>
                        </td>
                        <td class="px-8 py-5 text-right">
                            <div class="flex items-center justify-end space-x-3">
                                <a href="{{ path('admin_background_edit', {'id': background.id}) }}" class="p-2 bg-slate-100 dark:bg-slate-800 rounded-xl text-slate-500 hover:text-primary transition-colors">
                                    {{ ux_icon('lucide:edit-3', {class: 'w-5 h-5'}) }}
                                </a>
                                {{ include('admin/background/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2" class="px-8 py-12 text-center text-slate-400">
                            Nenhum antecedente encontrado.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
