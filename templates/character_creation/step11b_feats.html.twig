{% extends 'character_creation/base_wizard.html.twig' %}

{% block title %}Criação de Personagem - Passo 11b: Talentos de Classe{% endblock %}

{% block wizard_content %}
<div class="max-w-4xl mx-auto">
    <div class="mb-8 text-center">
        <h1 class="text-3xl font-bold text-indigo-900 mb-2">Talentos de Classe</h1>
        <p class="text-indigo-600">Sua classe permite a escolha de talentos adicionais.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-indigo-100">
        <div class="p-8">
            <div class="flex items-center justify-between mb-6">
                 <h2 class="text-xl font-bold text-indigo-900">Escolha seus Talentos</h2>
                 <div class="px-4 py-2 bg-indigo-100 text-indigo-800 rounded-lg font-bold">
                    Escolhas Restantes: <span id="slots-remaining">{{ feats_known - current_feat_ids|length }}</span> de {{ feats_known }}
                 </div>
            </div>

            <form method="post" id="wizard-form">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {% for feat in available_feats %}
                        <label class="relative flex items-start gap-4 p-4 rounded-xl border-2 cursor-pointer transition-all hover:border-indigo-300 hover:bg-indigo-50 {% if feat.id in current_feat_ids %}border-indigo-600 bg-indigo-50{% else %}border-slate-200{% endif %} js-feat-card">
                            <input type="checkbox" name="feats[]" value="{{ feat.id }}" class="mt-1 w-5 h-5 text-indigo-600 rounded focus:ring-indigo-500 js-feat-checkbox" 
                                {% if feat.id in current_feat_ids %}checked{% endif %}
                            >
                            <div>
                                <div class="font-bold text-indigo-900 mb-1">{{ feat.name }}</div>
                                <div class="text-xs font-bold uppercase tracking-wider text-indigo-500 mb-2">{{ feat.type }}</div>
                                {% if feat.prerequisite %}
                                    <div class="text-xs text-amber-600 mb-2">Pré-req: {{ feat.prerequisite }}</div>
                                {% endif %}
                                <div class="text-sm text-slate-600 line-clamp-3">{{ feat.descriptionMd|striptags }}</div>
                            </div>
                        </label>
                    {% else %}
                        <div class="col-span-2 text-center py-12 text-slate-500 italic">
                            Nenhum talento disponível para escolha.
                        </div>
                    {% endfor %}
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block wizard_actions %}
    <a href="{{ path('app_character_creation_step11', {'id': character.id}) }}" class="px-6 py-3 rounded-xl font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
        Voltar
    </a>
    <button type="submit" form="wizard-form" class="bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-xl font-bold shadow-lg shadow-indigo-500/25 transition-all flex items-center gap-2">
        <span>Salvar Talentos</span>
        {{ ux_icon('lucide:arrow-right', {class: 'w-5 h-5'}) }}
    </button>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const maxSlots = {{ feats_known }};
            const updateCounter = () => {
                const checked = document.querySelectorAll('.js-feat-checkbox:checked').length;
                const remaining = maxSlots - checked;
                document.getElementById('slots-remaining').textContent = remaining >= 0 ? remaining : 0;
                
                // Visual feedback
                document.querySelectorAll('.js-feat-card').forEach(card => {
                    const checkbox = card.querySelector('input');
                    if (checkbox.checked) {
                        card.classList.add('border-indigo-600', 'bg-indigo-50');
                        card.classList.remove('border-slate-200');
                    } else {
                        card.classList.remove('border-indigo-600', 'bg-indigo-50');
                        card.classList.add('border-slate-200');
                    }
                });
            };

            document.querySelectorAll('.js-feat-checkbox').forEach(cb => {
                cb.addEventListener('change', (e) => {
                     const checked = document.querySelectorAll('.js-feat-checkbox:checked').length;
                     if (checked > maxSlots) {
                         e.target.checked = false;
                         alert(`Você só pode escolher ${maxSlots} talentos.`);
                     }
                    updateCounter();
                });
            });
            
            updateCounter();
        });
    </script>
{% endblock %}

