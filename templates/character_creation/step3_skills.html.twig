{% extends 'character_creation/base_wizard.html.twig' %}

{% set step = 3 %}

{% block wizard_content %}
<form id="wizard-form" method="post" action="{{ path('app_character_creation_step3', {id: character.id}) }}">
    
    {# Top Instruction #}
    <div class="mb-8 text-center" id="initial-instruction">
        <h2 class="text-2xl font-bold text-slate-800 dark:text-white mb-2">Escolha suas Perícias</h2>
        <p class="text-slate-500">
            Sua classe <strong>{{ character.classDef.name }}</strong> permite escolher 
            <span class="font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/30 px-2 py-0.5 rounded">{{ max_skills }}</span> 
            perícias iniciais da lista abaixo.
        </p>
    </div>

    <div class="max-w-4xl mx-auto h-[calc(100vh-16rem)] flex flex-col">
        
        {# Skills Grid #}
        <div class="flex-1 overflow-y-auto custom-scrollbar p-1">
            
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-6 p-4 rounded-xl bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-800 text-center text-sm font-bold">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {% for skill in available_skills %}
                    {% set is_selected = false %}
                    {% for current in current_skills %}
                        {% if current.id == skill.id %}
                            {% set is_selected = true %}
                        {% endif %}
                    {% endfor %}

                    <label class="cursor-pointer group relative">
                        <input type="checkbox" name="skills[]" value="{{ skill.id }}" 
                               class="peer sr-only skill-checkbox" 
                               {% if is_selected %}checked{% endif %}
                               onchange="checkLimit()">
                        
                        <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-indigo-300 dark:hover:border-indigo-700 hover:shadow-md transition-all h-full peer-checked:border-indigo-500 dark:peer-checked:border-indigo-500 peer-checked:ring-1 peer-checked:ring-indigo-500 peer-disabled:opacity-50 peer-disabled:cursor-not-allowed">
                            <div class="flex items-start justify-between mb-2">
                                <h3 class="font-bold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">{{ skill.name }}</h3>
                                <div class="w-5 h-5 rounded-full border-2 border-slate-300 dark:border-slate-600 peer-checked:bg-indigo-500 peer-checked:border-indigo-500 flex items-center justify-center transition-colors">
                                    {{ ux_icon('lucide:check', {class: 'w-3 h-3 text-white opacity-0 peer-checked:opacity-100'}) }}
                                </div>
                            </div>
                            
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed mb-2">
                                {{ skill.description|default('Sem descrição.')|u.truncate(120, '...') }}
                            </p>

                            <div class="flex items-center gap-2">
                                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 uppercase tracking-wide">{{ skill.attribute.name|default('-') }}</span>
                            </div>
                        </div>

                        {# Check Visual Indicator #}
                        <div class="absolute top-4 right-4 w-5 h-5 rounded border-2 border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 peer-checked:bg-indigo-600 peer-checked:border-indigo-600 transition-all flex items-center justify-center pointer-events-none">
                            {{ ux_icon('lucide:check', {class: 'w-3.5 h-3.5 text-white opacity-0 peer-checked:opacity-100 transition-opacity'}) }}
                        </div>
                    </label>
                {% endfor %}
            </div>
        </div>

        {# Footer Status #}
        <div class="mt-6 flex justify-between items-center p-4 bg-slate-50 dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
            <div class="text-sm">
                <span class="text-slate-500">Selecionadas:</span>
                <strong class="text-slate-800 dark:text-white" id="count-display">0</strong>
                <span class="text-slate-400">/ {{ max_skills }}</span>
            </div>
            {# Main action buttons are in base_wizard, but we could add clear button here if needed #}
        </div>
    </div>
</form>

<script>
    const maxSkills = {{ max_skills }};
    
    function checkLimit() {
        const checkboxes = document.querySelectorAll('.skill-checkbox');
        const checkedCount = document.querySelectorAll('.skill-checkbox:checked').length;
        const countDisplay = document.getElementById('count-display');
        
        // Update display
        if(countDisplay) countDisplay.textContent = checkedCount;

        // Disable unchecked if limit reached
        if (checkedCount >= maxSkills) {
            checkboxes.forEach(cb => {
                if (!cb.checked) {
                    cb.disabled = true;
                    cb.parentElement.classList.add('opacity-50', 'pointer-events-none');
                }
            });
        } else {
            checkboxes.forEach(cb => {
                cb.disabled = false;
                cb.parentElement.classList.remove('opacity-50', 'pointer-events-none');
            });
        }
    }

    // Init
    document.addEventListener('DOMContentLoaded', checkLimit);
</script>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: rgba(156, 163, 175, 0.3);
        border-radius: 20px;
    }
</style>
{% endblock %}
