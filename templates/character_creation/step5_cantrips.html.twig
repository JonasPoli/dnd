{% extends 'character_creation/base_wizard.html.twig' %}

{% set step = 5 %}

{% block wizard_content %}
<form id="wizard-form" method="post" action="{{ path('app_character_creation_step5', {id: character.id}) }}">
    
    {# Top Instruction #}
    <div class="mb-8 text-center" id="initial-instruction">
        <h2 class="text-2xl font-bold text-slate-800 dark:text-white mb-2">Escolha seus Truques</h2>
        <p class="text-slate-500">
            Sua classe <strong>{{ character.classDef.name }}</strong> conhece 
            <span class="font-bold text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/30 px-2 py-0.5 rounded">{{ max_cantrips }}</span> 
            truques neste nível.
        </p>
    </div>

    <div class="max-w-6xl mx-auto h-[calc(100vh-16rem)] flex flex-col">
        
        {# Content #}
        <div class="flex-1 overflow-y-auto custom-scrollbar p-1">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-6 p-4 rounded-xl bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-800 text-center text-sm font-bold">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for spell in available_cantrips %}
                    {% set is_selected = false %}
                    {% if spell.id in current_cantrip_ids %}
                        {% set is_selected = true %}
                    {% endif %}

                    <label class="cursor-pointer group relative cantrip-card">
                        <input type="checkbox" name="cantrips[]" value="{{ spell.id }}" 
                               class="peer sr-only cantrip-checkbox" 
                               {% if is_selected %}checked{% endif %}
                               onchange="checkLimit()">
                        
                        <div class="p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-amber-400 dark:hover:border-amber-600 hover:shadow-lg transition-all h-full peer-checked:border-amber-500 dark:peer-checked:border-amber-500 peer-checked:ring-1 peer-checked:ring-amber-500 peer-disabled:opacity-50 peer-disabled:cursor-not-allowed flex flex-col">
                            
                            {# Header #}
                            <div class="flex items-start justify-between mb-3 border-b border-slate-100 dark:border-slate-800 pb-3">
                                <div>
                                    <h3 class="font-bold text-lg text-slate-800 dark:text-slate-200 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors leading-tight">
                                        {{ spell.namePt|default(spell.name) }}
                                    </h3>
                                    <div class="text-xs text-slate-500 mt-1 flex gap-2">
                                        <span class="flex items-center gap-1">{{ ux_icon('lucide:sparkles', {class: 'w-3 h-3'}) }} {{ spell.school.value|default('Escola') }}</span>
                                    </div>
                                </div>
                                <div class="w-5 h-5 rounded-full border-2 border-slate-300 dark:border-slate-600 peer-checked:bg-amber-500 peer-checked:border-amber-500 flex items-center justify-center transition-colors shrink-0">
                                    {{ ux_icon('lucide:check', {class: 'w-3 h-3 text-white opacity-0 peer-checked:opacity-100'}) }}
                                </div>
                            </div>
                            
                            {# Tags / Meta #}
                            <div class="flex flex-wrap gap-2 mb-3 text-[10px] uppercase font-bold text-slate-500">
                                <span class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded flex items-center gap-1" title="Tempo de Conjuração">
                                    {{ ux_icon('lucide:clock', {class: 'w-3 h-3'}) }} {{ spell.castingTime }}
                                </span>
                                <span class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded flex items-center gap-1" title="Alcance">
                                    {{ ux_icon('lucide:crosshair', {class: 'w-3 h-3'}) }} {{ spell.spellRange }}
                                </span>
                                <span class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded flex items-center gap-1" title="Duração">
                                    {{ ux_icon('lucide:hourglass', {class: 'w-3 h-3'}) }} {{ spell.duration }}
                                </span>
                                <span class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded" title="Componentes">
                                    {% if spell.isVerbal %}V{% endif %}
                                    {% if spell.isSomatic %}S{% endif %}
                                    {% if spell.isMaterial %}M{% endif %}
                                </span>
                                {% if spell.isRitual %}
                                    <span class="bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 px-1.5 py-0.5 rounded flex items-center gap-1">
                                        {{ ux_icon('lucide:book-open', {class: 'w-3 h-3'}) }} Ritual
                                    </span>
                                {% endif %}
                                {% if spell.isConcentration %}
                                    <span class="bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 px-1.5 py-0.5 rounded flex items-center gap-1">
                                        {{ ux_icon('lucide:brain-circuit', {class: 'w-3 h-3'}) }} Conc.
                                    </span>
                                {% endif %}
                            </div>

                            {# Description #}
                            <div class="prose prose-sm dark:prose-invert prose-p:text-slate-600 dark:prose-p:text-slate-400 max-h-32 overflow-hidden relative group-hover:max-h-96 transition-all duration-500 ease-in-out">
                                <div class="js-markdown-content text-xs leading-relaxed">
                                    {{ spell.descriptionMdPt|default(spell.descriptionMd)|default('Sem descrição.') }}
                                </div>
                                <!-- Fade out effect for collapsed state -->
                                <div class="absolute bottom-0 left-0 right-0 h-8 bg-gradient-to-t from-white dark:from-slate-900 to-transparent pointer-events-none group-hover:opacity-0 transition-opacity"></div>
                            </div>

                        </div>
                    </label>
                {% endfor %}
            </div>
        </div>

        {# Footer Status #}
        <div class="mt-6 flex justify-between items-center p-4 bg-slate-50 dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
            <div class="text-sm">
                <span class="text-slate-500">Selecionados:</span>
                <strong class="text-slate-800 dark:text-white" id="count-display">0</strong>
                <span class="text-slate-400">/ {{ max_cantrips }}</span>
            </div>
        </div>
    </div>
</form>

<script type="module">
    import { marked } from 'https://cdn.jsdelivr.net/npm/marked/lib/marked.esm.js';
    
    document.addEventListener('DOMContentLoaded', () => {
        // Render Markdown
        document.querySelectorAll('.js-markdown-content').forEach(el => {
            const rawContent = el.textContent.trim();
            if (rawContent) {
                 el.innerHTML = marked.parse(rawContent);
            }
        });
        
        checkLimit();
    });
</script>

<script>
    const maxCantrips = {{ max_cantrips }};
    
    function checkLimit() {
        if (maxCantrips <= 0) return;
        
        const checkboxes = document.querySelectorAll('.cantrip-checkbox');
        const checkedCount = document.querySelectorAll('.cantrip-checkbox:checked').length;
        const countDisplay = document.getElementById('count-display');
        
        // Update display
        if(countDisplay) countDisplay.textContent = checkedCount;

        // Disable unchecked if limit reached
        if (checkedCount >= maxCantrips) {
            checkboxes.forEach(cb => {
                if (!cb.checked) {
                    cb.disabled = true;
                    // Disable visual wrapper
                    const wrapper = cb.nextElementSibling; 
                    if(wrapper) wrapper.classList.add('opacity-50', 'pointer-events-none');
                }
            });
        } else {
            checkboxes.forEach(cb => {
                cb.disabled = false;
                const wrapper = cb.nextElementSibling; 
                if(wrapper) wrapper.classList.remove('opacity-50', 'pointer-events-none');
            });
        }
    }
</script>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: rgba(156, 163, 175, 0.3);
        border-radius: 20px;
    }
    
    /* Tweak markdown styles for small card context */
    .js-markdown-content p {
        margin-bottom: 0.5em !important;
    }
    .js-markdown-content ul {
        padding-left: 1.25em !important;
        list-style-type: disc !important;
    }
</style>
{% endblock %}
