{% extends 'character_creation/base_wizard.html.twig' %}

{% set step = 2 %}

{% block wizard_content %}
<form id="wizard-form" method="post" action="{{ path('app_character_creation_step2', {id: character.id}) }}">
    
    {# Top Instruction #}
    <div class="mb-8 text-center" id="initial-instruction">
        <h2 class="text-2xl font-bold text-slate-800 dark:text-white mb-2">Escolha sua Subclasse</h2>
        <p class="text-slate-500">Defina a especialização do seu {{ character.classDef.name }}.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 h-[calc(100vh-16rem)]">
        
        {# Left Column: Subclass List #}
        <div class="lg:col-span-4 flex flex-col h-full bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
            <div class="p-6 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50">
                <h2 class="text-lg font-bold text-slate-800 dark:text-white">Subclasses de {{ character.classDef.name }}</h2>
                <p class="text-xs text-slate-500 mt-1">Caminhos disponíveis</p>
            </div>
            
            <div class="flex-1 overflow-y-auto p-4 space-y-2 custom-scrollbar">
                {% if subclasses is empty %}
                    <div class="p-4 text-center text-slate-500 text-sm">
                        Nenhuma subclasse encontrada para esta classe.
                    </div>
                {% else %}
                    {% for subclass in subclasses %}
                        <label class="cursor-pointer group block">
                            <input type="radio" name="subclass_def" value="{{ subclass.id }}" class="peer sr-only" {% if current_subclass and current_subclass.id == subclass.id %}checked{% endif %} required onchange="updateDetails('{{ subclass.id }}')">
                            <div class="p-3 rounded-xl border border-transparent hover:bg-slate-50 dark:hover:bg-slate-800 peer-checked:bg-purple-50 dark:peer-checked:bg-purple-900/20 peer-checked:border-purple-200 dark:peer-checked:border-purple-800 transition-all flex items-center gap-3">
                                
                                <div class="flex-1 min-w-0">
                                    <h3 class="font-bold text-sm text-slate-700 dark:text-slate-200 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors truncate">{{ subclass.name }}</h3>
                                    <div class="flex items-center gap-2 mt-0.5">
                                        <span class="text-[10px] text-slate-400">Nível {{ subclass.availableFromLevel }}</span>
                                    </div>
                                </div>

                                {{ ux_icon('lucide:chevron-right', {class: 'w-4 h-4 text-slate-300 peer-checked:text-purple-500 transition-colors'}) }}
                            </div>
                        </label>

                        {# Hidden Data for JS update #}
                        <template id="details-{{ subclass.id }}">
                            <div class="animate-in fade-in slide-in-from-bottom-4 duration-500 space-y-6">
                                {# Header Card #}
                                <div class="bg-gradient-to-r from-purple-900 to-indigo-900 dark:from-purple-800 dark:to-indigo-800 rounded-2xl p-6 flex items-center gap-6 shadow-lg text-white">
                                    <div>
                                        <h2 class="text-3xl font-bold font-serif text-white">{{ subclass.name }}</h2>
                                        <p class="text-purple-200 italic">Subclasse de {{ character.classDef.name }}</p>
                                    </div>
                                </div>

                                {# Content Tabs/Sections #}
                                <div class="space-y-6">
                                    {% if subclass.descriptionMd %}
                                    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm">
                                        <h3 class="font-bold text-slate-900 dark:text-white flex items-center gap-2 mb-4">
                                            {{ ux_icon('lucide:book-open', {class: 'w-5 h-5 text-purple-500'}) }}
                                            Descrição
                                        </h3>
                                        <div class="prose prose-sm prose-slate dark:prose-invert max-w-none js-markdown-content" data-content="{{ subclass.descriptionMd|e('html_attr') }}"></div>
                                    </div>
                                    {% endif %}
                                </div>
                            </div>
                        </template>
                    {% endfor %}
                {% endif %}
            </div>
        </div>

        {# Right Column: Details Preview #}
        <div class="lg:col-span-8 flex flex-col h-full bg-slate-50 dark:bg-slate-950/50 rounded-3xl border border-slate-200 dark:border-slate-800 overflow-hidden relative">
            <div id="details-container" class="flex-1 overflow-y-auto p-8 custom-scrollbar">
                {# Initial Empty State #}
                <div class="flex flex-col items-center justify-center h-full text-center text-slate-400">
                    <div class="w-24 h-24 rounded-full bg-slate-100 dark:bg-slate-900 flex items-center justify-center mb-6 animate-pulse">
                        {{ ux_icon('lucide:layout-list', {class: 'w-10 h-10 opacity-50'}) }}
                    </div>
                    <p class="text-xl font-medium text-slate-600 dark:text-slate-400">Preview da Subclasse</p>
                    <p class="text-sm mt-2 max-w-xs mx-auto">Selecione uma opção à esquerda para ver os detalhes da especialização.</p>
                </div>
            </div>
        </div>
    </div>
</form>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
    function updateDetails(id) {
        const template = document.getElementById('details-' + id);
        const container = document.getElementById('details-container');
        const instruction = document.getElementById('initial-instruction');
        
        if (template && container) {
            container.innerHTML = template.innerHTML;
            
            // Render Markdown for the new content
            container.querySelectorAll('.js-markdown-content').forEach(el => {
                if (el.dataset.content) {
                    el.innerHTML = marked.parse(el.dataset.content);
                }
            });

            // Hide instruction if shown
             if (instruction) instruction.style.display = 'none';
        }
    }

    // Initialize with selected if any
    document.addEventListener('DOMContentLoaded', () => {
        const checked = document.querySelector('input[name="subclass_def"]:checked');
        if (checked) {
            updateDetails(checked.value);
        }
    });
</script>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: rgba(156, 163, 175, 0.3);
        border-radius: 20px;
    }

    /* Markdown Typography Improvements - Vanilla CSS */
    .js-markdown-content {
        line-height: 1.6;
        color: #334155; /* slate-700 */
    }

    .js-markdown-content p {
        margin-bottom: 1.25rem;
    }

    .js-markdown-content h1,
    .js-markdown-content h2,
    .js-markdown-content h3,
    .js-markdown-content h4,
    .js-markdown-content h5,
    .js-markdown-content h6 {
        font-weight: 700;
        color: #1e293b;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        line-height: 1.3;
    }

    .js-markdown-content h1 {
        font-size: 1.875rem;
        line-height: 2.25rem;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 0.5rem;
        color: #581c87; /* purple-900 */
    }

    .js-markdown-content h2 {
        font-size: 1.5rem;
        line-height: 2rem;
        color: #6b21a8; /* purple-800 */
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 0.25rem;
    }

    .js-markdown-content h3 {
        font-size: 1.25rem;
        line-height: 1.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #7e22ce; /* purple-700 */
        margin-top: 2.5rem;
    }
    
    /* Dark Mode Overrides */
    :is(.dark .js-markdown-content) {
        color: #cbd5e1;
    }
    :is(.dark .js-markdown-content h1) {
        border-color: #334155;
        color: #c084fc; /* purple-400 */
    }
    :is(.dark .js-markdown-content h2) {
        border-color: #334155;
        color: #d8b4fe; /* purple-300 */
    }
    :is(.dark .js-markdown-content h3) {
        color: #e9d5ff; /* purple-200 */
    }
    :is(.dark .js-markdown-content h4),
    :is(.dark .js-markdown-content h5),
    :is(.dark .js-markdown-content strong) {
        color: #f1f5f9;
    }

    .js-markdown-content ul {
        list-style-type: disc;
        padding-left: 1.5rem;
        margin-bottom: 1.25rem;
    }
    .js-markdown-content li {
        margin-bottom: 0.25rem;
    }

    .js-markdown-content strong {
        font-weight: 700;
        color: #0f172a;
    }

    /* Table Styles */
    .js-markdown-content table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1.5rem;
        font-size: 0.875rem;
    }

    .js-markdown-content th {
        background-color: #f1f5f9;
        color: #334155;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        padding: 0.75rem 1rem;
        border-bottom: 2px solid #e2e8f0;
        text-align: left;
    }

    .js-markdown-content td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #e2e8f0;
        color: #475569;
    }

    .js-markdown-content tr:nth-child(even) {
        background-color: #f8fafc;
    }

    /* Dark Mode Table overrides */
    :is(.dark .js-markdown-content th) {
        background-color: #1e293b;
        color: #cbd5e1;
        border-color: #334155;
    }
    :is(.dark .js-markdown-content td) {
        border-color: #334155;
        color: #94a3b8;
    }
    :is(.dark .js-markdown-content tr:nth-child(even)) {
        background-color: rgba(30, 41, 59, 0.5);
    }
</style>
{% endblock %}
