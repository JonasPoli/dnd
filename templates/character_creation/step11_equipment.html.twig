{% extends 'character_creation/base_wizard.html.twig' %}

{% set step = 11 %}

{% block wizard_content %}
<div class="space-y-6" data-controller="equipment-filter">
    
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-bold dark:text-white">Equipamentos & Moedas</h2>
        <div class="text-right text-sm text-slate-500">
            <p>Gerencie seu inventário inicial.</p>
            {% if character.classDef.equipment %}
                <div class="text-xs text-slate-400 mt-2 max-w-md ml-auto text-right prose prose-invert prose-xs">
                    <strong class="block text-slate-500 mb-1">Sugestão de Classe:</strong>
                    {{ character.classDef.equipment|markdown_to_html }}
                </div>
            {% endif %}
            {% if character.background.startingEquipment|length > 0 %}
                <div class="text-xs text-slate-400 mt-2 max-w-md ml-auto text-right">
                    <strong class="block text-slate-500 mb-1">Do Antecedente:</strong>
                     <ul class="list-none space-y-0.5">
                        {% for item in character.background.startingEquipment %}
                            <li>{{ item.namePt|default(item.name) }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        {# Left Column: Available Equipment #}
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-4 shadow-sm h-[600px] flex flex-col">
            <h3 class="font-bold text-lg mb-4 text-slate-800 dark:text-white flex items-center gap-2">
                {{ ux_icon('lucide:shopping-bag', {class: 'w-5 h-5'}) }}
                <span>Loja de Equipamentos</span>
            </h3>

            {# Filters #}
            <div class="flex gap-2 mb-4 overflow-x-auto pb-2 scrollbar-hide">
                <button type="button" onclick="filterItems('all')" class="px-3 py-1 bg-slate-100 dark:bg-slate-800 rounded-full text-xs font-bold hover:bg-indigo-100 hover:text-indigo-600 transition-colors whitespace-nowrap active-filter ring-2 ring-indigo-500 ring-offset-2">Todos</button>
                <button type="button" onclick="filterItems('Arma')" class="px-3 py-1 bg-slate-100 dark:bg-slate-800 rounded-full text-xs font-bold hover:bg-indigo-100 hover:text-indigo-600 transition-colors whitespace-nowrap">Armas</button>
                <button type="button" onclick="filterItems('Armadura')" class="px-3 py-1 bg-slate-100 dark:bg-slate-800 rounded-full text-xs font-bold hover:bg-indigo-100 hover:text-indigo-600 transition-colors whitespace-nowrap">Armaduras</button>
                <button type="button" onclick="filterItems('Ferramenta')" class="px-3 py-1 bg-slate-100 dark:bg-slate-800 rounded-full text-xs font-bold hover:bg-indigo-100 hover:text-indigo-600 transition-colors whitespace-nowrap">Ferramentas</button>
                <button type="button" onclick="filterItems('Equipamento de Aventura')" class="px-3 py-1 bg-slate-100 dark:bg-slate-800 rounded-full text-xs font-bold hover:bg-indigo-100 hover:text-indigo-600 transition-colors whitespace-nowrap">Aventura</button>
                <button type="button" onclick="filterItems('Montaria')" class="px-3 py-1 bg-slate-100 dark:bg-slate-800 rounded-full text-xs font-bold hover:bg-indigo-100 hover:text-indigo-600 transition-colors whitespace-nowrap">Montarias</button>
            </div>
            
            {# Search #}
            <div class="mb-4 relative">
                <input type="text" id="equipmentSearch" onkeyup="searchItems()" placeholder="Buscar item..." class="w-full pl-10 pr-4 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                {{ ux_icon('lucide:search', {class: 'w-4 h-4 absolute left-3 top-3 text-slate-400'}) }}
            </div>

            {# List #}
            <div class="flex-1 overflow-y-auto pr-2 space-y-2" id="availableList">
                {% for item in equipment_list %}
                    <form method="post" class="equipment-item group flex items-center justify-between p-3 bg-slate-50 dark:bg-slate-800/50 rounded-xl border border-transparent hover:border-indigo-200 dark:hover:border-indigo-800 transition-all" data-type="{{ item.typePt|default(item.type) }}" data-name="{{ item.namePt|default(item.name)|lower }}">
                        <input type="hidden" name="action" value="add">
                        <input type="hidden" name="item_id" value="{{ item.id }}">
                        
                        <div class="flex-1 min-w-0 mr-4">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="font-bold text-sm text-slate-900 dark:text-white truncate">{{ item.namePt|default(item.name) }}</span>
                                <span class="text-[10px] bg-slate-200 dark:bg-slate-700 px-1.5 py-0.5 rounded text-slate-600 dark:text-slate-400 capitalize">{{ item.typePt|default(item.type) }}</span>
                            </div>
                            <div class="flex gap-3 text-xs text-slate-500">
                                {% if item.damageDice %}
                                    <span title="Dano" class="flex items-center gap-1">{{ ux_icon('lucide:sword', {class: 'w-3 h-3'}) }} {{ item.damageDice }} {{ item.damageTypePt|slice(0,3) }}</span>
                                {% endif %}
                                {% if item.costGp %}
                                    <span title="Custo" class="flex items-center gap-1 text-amber-600 font-bold">{{ ux_icon('lucide:coins', {class: 'w-3 h-3'}) }} {{ item.costGp }} PO</span>
                                {% endif %}
                                {% if item.weightKg %}
                                    <span title="Peso" class="flex items-center gap-1">{{ ux_icon('lucide:weight', {class: 'w-3 h-3'}) }} {{ item.weightKg }}kg</span>
                                {% endif %}
                            </div>
                        </div>
                        
                        <button type="submit" class="p-2 bg-white dark:bg-slate-700 rounded-lg text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 transition-colors shadow-sm opacity-0 group-hover:opacity-100 focus:opacity-100">
                            {{ ux_icon('lucide:plus', {class: 'w-5 h-5'}) }}
                        </button>
                    </form>
                {% endfor %}
                 <div id="noResults" class="hidden text-center py-8 text-slate-400 text-sm">Nenhum item encontrado.</div>
            </div>
        </div>

        {# Right Column: Inventory & Stats #}
        <div class="flex flex-col h-[600px]">
            
            {# Inventory List #}
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-4 shadow-sm flex-1 flex flex-col mb-4 overflow-hidden">
                <h3 class="font-bold text-lg mb-4 text-slate-800 dark:text-white flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        {{ ux_icon('lucide:backpack', {class: 'w-5 h-5'}) }}
                        <span>Seu Inventário</span>
                    </div>
                    <span class="text-xs font-normal bg-indigo-100 text-indigo-700 px-2 py-1 rounded-full">{{ character.inventory|length }} items</span>
                </h3>

                <div class="flex-1 overflow-y-auto pr-2 space-y-2">
                    {% for item in character.inventory %}
                         <form method="post" class="flex items-center justify-between p-3 bg-indigo-50/50 dark:bg-indigo-900/10 rounded-xl border border-indigo-100 dark:border-indigo-900/30">
                            <input type="hidden" name="action" value="remove">
                            <input type="hidden" name="item_id" value="{{ item.id }}">
                            
                            <div class="flex-1">
                                <div class="font-bold text-sm text-slate-900 dark:text-white">{{ item.namePt|default(item.name) }}</div>
                                <div class="text-xs text-slate-500">{{ item.weightKg }}kg</div>
                            </div>
                             <button type="submit" class="p-1.5 text-slate-400 hover:text-red-500 transition-colors" title="Remover">
                                {{ ux_icon('lucide:trash-2', {class: 'w-4 h-4'}) }}
                            </button>
                        </form>
                    {% else %}
                        <div class="text-center py-12 text-slate-400">
                            {{ ux_icon('lucide:package-open', {class: 'w-12 h-12 mx-auto mb-2 opacity-50'}) }}
                            <p class="text-sm">Seu inventário está vazio.</p>
                        </div>
                    {% endfor %}
                </div>
                
                 {# Totals #}
                <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50 -m-4 p-4 rounded-b-2xl">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="text-center p-2 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
                            <span class="block text-xs uppercase font-bold text-slate-400 mb-1">Peso Total</span>
                            <span class="block text-xl font-bold {{ current_weight > 50 ? 'text-orange-500' : 'text-slate-800 dark:text-white' }}">{{ current_weight|number_format(1) }} <small class="text-xs text-slate-400">kg</small></span>
                        </div>
                        <div class="text-center p-2 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
                            <span class="block text-xs uppercase font-bold text-slate-400 mb-1">Custo Total</span>
                            <span class="block text-xl font-bold text-amber-600">{{ current_cost }} <small class="text-xs text-amber-600/70">PO</small></span>
                        </div>
                    </div>
                </div>
            </div>

            {# Currency #}
            <div class="bg-indigo-900 text-white rounded-2xl p-4 shadow-lg">
                <h3 class="font-bold text-sm uppercase tracking-wider mb-3 flex items-center gap-2 opacity-80">
                    {{ ux_icon('lucide:coins', {class: 'w-4 h-4'}) }} Tesouro Inicial
                </h3>
                <div class="grid grid-cols-5 gap-2" id="coinInputs">
                    {# Managed by JS via form submission #}
                    <div>
                        <label class="block text-[10px] font-bold text-indigo-300 mb-1 text-center">PC</label>
                        <input type="number" id="inputCp" value="{{ character.coinCp }}" class="w-full bg-indigo-800 border-indigo-700 rounded-lg text-center text-sm font-bold focus:ring-2 focus:ring-white">
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-indigo-300 mb-1 text-center">PP</label>
                        <input type="number" id="inputSp" value="{{ character.coinSp }}" class="w-full bg-indigo-800 border-indigo-700 rounded-lg text-center text-sm font-bold focus:ring-2 focus:ring-white">
                    </div>
                     <div>
                        <label class="block text-[10px] font-bold text-indigo-300 mb-1 text-center">PE</label>
                        <input type="number" id="inputEp" value="{{ character.coinEp }}" class="w-full bg-indigo-800 border-indigo-700 rounded-lg text-center text-sm font-bold focus:ring-2 focus:ring-white">
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-amber-300 mb-1 text-center">PO</label>
                        <input type="number" id="inputGp" value="{{ character.coinGp }}" class="w-full bg-indigo-800 border-indigo-700 rounded-lg text-center text-sm font-bold focus:ring-2 focus:ring-amber-400 text-amber-300">
                    </div>
                   <div>
                        <label class="block text-[10px] font-bold text-indigo-100 mb-1 text-center">PL</label>
                        <input type="number" id="inputPp" value="{{ character.coinPp }}" class="w-full bg-indigo-800 border-indigo-700 rounded-lg text-center text-sm font-bold focus:ring-2 focus:ring-white">
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Real Form for Next Step #}
    <form id="wizard-form" method="post">
        <input type="hidden" name="action" value="next">
        <input type="hidden" name="coinC" id="formCp">
        <input type="hidden" name="coinS" id="formSp">
        <input type="hidden" name="coinE" id="formEp">
        <input type="hidden" name="coinG" id="formGp">
        <input type="hidden" name="coinP" id="formPp">
    </form>
    
    <script>
        // Sync Coins on Submit
        document.getElementById('wizard-form').addEventListener('submit', function() {
            document.getElementById('formCp').value = document.getElementById('inputCp').value;
            document.getElementById('formSp').value = document.getElementById('inputSp').value;
            document.getElementById('formEp').value = document.getElementById('inputEp').value;
            document.getElementById('formGp').value = document.getElementById('inputGp').value;
            document.getElementById('formPp').value = document.getElementById('inputPp').value;
        });

        // Search & Filter
        function searchItems() {
            let input = document.getElementById('equipmentSearch').value.toLowerCase();
            let items = document.querySelectorAll('.equipment-item');
            let hasResults = false;

            items.forEach(item => {
                let name = item.getAttribute('data-name');
                let type = item.getAttribute('data-type'); // Need to respect filter too? 
                // Simple combining: check visibility style first? No, easier to just run both checks.
                
                // Let's assume current active filter is tracked or simpler: Just search text.
                // Refined: Check display property
                if (item.style.display !== 'none' || !item.hasAttribute('data-filtered-out')) {
                     if (name.includes(input)) {
                        item.classList.remove('hidden');
                        hasResults = true;
                    } else {
                        item.classList.add('hidden');
                    }
                }
            });
            
             // Re-run filter to ensure we respect category
             // Actually, let's keep it simple: Search searches everything visible in current filter? 
             // Or search resets filter?
             // Implementation: Search runs on top of filter.
        }

        function filterItems(type) {
            let items = document.querySelectorAll('.equipment-item');
            // Reset Active Class
            
            items.forEach(item => {
                let itemType = item.getAttribute('data-type');
                if (type === 'all' || itemType.includes(type)) { // Includes partial match for safety
                    item.classList.remove('hidden');
                    item.removeAttribute('data-filtered-out');
                } else {
                    item.classList.add('hidden');
                    item.setAttribute('data-filtered-out', 'true');
                }
            });
            
            // Re-run search if text exists
            let searchText = document.getElementById('equipmentSearch').value;
            if(searchText) searchItems();
        }
    </script>
</div>
{% endblock %}

{% block wizard_actions %}
    <a href="{{ path('app_character_creation_step10', {id: character.id}) }}" class="px-6 py-3 rounded-xl font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all flex items-center gap-2">
        {{ ux_icon('lucide:arrow-left', {class: 'w-5 h-5'}) }}
        <span>Voltar</span>
    </a>
    <button type="submit" form="wizard-form" class="bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-xl font-bold shadow-lg shadow-indigo-500/25 transition-all flex items-center gap-2">
        <span>Finalizar Detalhes</span>
        {{ ux_icon('lucide:arrow-right', {class: 'w-5 h-5'}) }}
    </button>
{% endblock %}
