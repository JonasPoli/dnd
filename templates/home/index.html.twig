{% extends 'base_landing.html.twig' %}

{% block title %}A Sociedade da Adaga de Prata{% endblock %}

{% block body %} 
    <!-- Navigation (Refined) -->
    <nav x-data="{ scrolled: false }" 
         @scroll.window="scrolled = (window.pageYOffset > 50)"
         :class="{ 'bg-slate-950/90 backdrop-blur-md border-b border-white/10': scrolled, 'bg-transparent border-transparent': !scrolled }"
         class="fixed top-0 w-full z-50 transition-all duration-300">
        <div class="container mx-auto px-4 h-20 flex items-center justify-between">
            <a href="#" class="flex items-center space-x-2 group">
                <div class="w-10 h-10 bg-red-900 rounded-full flex items-center justify-center text-amber-500 font-bold border border-amber-500/30 group-hover:border-amber-500 transition-colors">
                    <span class="font-medieval text-xl">AP</span>
                </div>
                <span class="font-fantasy font-bold text-amber-100 text-lg tracking-widest group-hover:text-amber-400 transition-colors">Adaga de Prata</span>
            </a>
            
            <div class="hidden md:flex items-center space-x-8">
                <a href="#hero" class="font-fantasy text-amber-100/80 hover:text-amber-400 text-sm tracking-wider uppercase transition-colors">Início</a>
                <a href="#party" class="font-fantasy text-amber-100/80 hover:text-amber-400 text-sm tracking-wider uppercase transition-colors">A Party</a>
                <a href="#campaign" class="font-fantasy text-amber-100/80 hover:text-amber-400 text-sm tracking-wider uppercase transition-colors">A Lenda</a>
                <a href="#join" class="px-6 py-2 bg-red-900/50 hover:bg-red-800 text-amber-100 font-fantasy text-sm border border-red-700 hover:border-red-500 rounded-sm transition-all shadow-[0_0_10px_rgba(220,38,38,0.2)] hover:shadow-[0_0_20px_rgba(220,38,38,0.4)]">
                    Junte-se
                </a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <div id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
        <!-- Background Overlay -->
        <div class="absolute inset-0 bg-gradient-to-b from-slate-900/40 via-slate-900/60 to-slate-950 z-10"></div>
        
        <!-- Generated Background Image -->
        <div class="absolute inset-0 z-0">
            <div class="absolute inset-0 bg-[url('/assets/images/bg-dungeon.png')] bg-cover bg-center bg-no-repeat filter brightness-75"></div>
        </div>

        <div class="container mx-auto px-4 relative z-20 text-center pt-20">
            <h2 class="font-medieval text-xl md:text-2xl text-amber-500 mb-4 tracking-widest uppercase animate-fade-in-down drop-shadow-md">Bem-vindo à</h2>
            <h1 class="font-fantasy text-5xl md:text-7xl lg:text-8xl font-bold text-transparent bg-clip-text bg-gradient-to-t from-amber-600 via-amber-200 to-white mb-8 drop-shadow-[0_4px_4px_rgba(0,0,0,0.9)]">
                Sociedade da<br/>Adaga de Prata
            </h1>
            <p class="font-lato text-lg md:text-xl text-slate-200 max-w-2xl mx-auto mb-12 leading-relaxed drop-shadow-md bg-slate-900/30 p-4 rounded-xl backdrop-blur-sm border border-white/5">
                Heróis improváveis unidos pelo destino, forjados no fogo da batalha e dedicados a proteger o reino das sombras que espreitam na escuridão.
            </p>
            
            <div class="flex flex-col md:flex-row items-center justify-center gap-6">
                <a href="#party" class="group relative px-8 py-4 bg-black/80 border border-amber-700/50 hover:border-amber-500 text-amber-100 font-fantasy tracking-wider uppercase transition-all duration-300 overflow-hidden min-w-[200px]">
                    <span class="relative z-10 group-hover:text-white transition-colors">Conheça a Party</span>
                    <div class="absolute inset-0 bg-gradient-to-r from-red-900/0 via-red-900/50 to-red-900/0 transform -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
                </a>
            </div>
        </div>

        <!-- Scroll Indicator -->
        <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20 animate-bounce text-amber-500/80">
            {{ ux_icon('lucide:chevron-down', {class: 'w-10 h-10'}) }}
        </div>
    </div>

    <!-- The Party Section -->
    <section id="party" class="py-32 bg-slate-950 relative">
        <!-- Decoration -->
        <div class="absolute top-0 left-0 w-full h-24 bg-gradient-to-b from-slate-950 to-transparent z-10"></div>
        
        <div class="container mx-auto px-4 relative z-20">
            <div class="text-center mb-20">
                <span class="text-amber-700 font-medieval text-lg">Os Guardiões</span>
                <h2 class="font-fantasy text-4xl md:text-6xl text-amber-500 mb-6 drop-shadow-lg">A ALIANÇA</h2>
                <div class="flex items-center justify-center gap-4 opacity-50">
                    <div class="h-px w-12 bg-amber-800"></div>
                    <div class="w-3 h-3 rotate-45 border border-amber-800"></div>
                    <div class="h-px w-12 bg-amber-800"></div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
                <!-- Character Card 1 (Dwarf) -->
                <div class="group relative bg-black border border-slate-800 hover:border-amber-600/50 hover:shadow-[0_0_30px_rgba(217,119,6,0.1)] transition-all duration-500 rounded-sm overflow-hidden">
                    <div class="aspect-[3/4] overflow-hidden relative">
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent z-10 opacity-80"></div>
                        <img src="/assets/images/char-dwarf.png" alt="Thorne" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 grayscale-[30%] group-hover:grayscale-0">
                    </div>
                    <div class="absolute bottom-0 left-0 right-0 p-8 z-20">
                        <h3 class="font-medieval text-3xl text-amber-100 mb-2 group-hover:text-amber-400 transition-colors">Thorne</h3>
                        <div class="flex items-center gap-3 mb-4">
                            <span class="px-2 py-0.5 bg-slate-800 border border-slate-700 text-xs uppercase tracking-wider text-slate-300 font-fantasy">Guerreiro</span>
                            <span class="w-1 h-1 bg-amber-500 rounded-full"></span>
                            <span class="text-amber-500/80 font-fantasy text-sm">Nível 5</span>
                        </div>
                        <p class="text-slate-400 text-sm leading-relaxed border-l-2 border-amber-900/50 pl-4 group-hover:border-amber-500 transition-colors">
                            A muralha de ferro da equipe. Onde Thorne planta seus pés, nenhum inimigo passa.
                        </p>
                    </div>
                </div>

                <!-- Character Card 2 (Elf) -->
                <div class="group relative bg-black border border-slate-800 hover:border-purple-500/50 hover:shadow-[0_0_30px_rgba(168,85,247,0.1)] transition-all duration-500 rounded-sm overflow-hidden">
                    <div class="aspect-[3/4] overflow-hidden relative">
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent z-10 opacity-80"></div>
                        <img src="/assets/images/char-elf.png" alt="Elara" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 grayscale-[30%] group-hover:grayscale-0">
                    </div>
                    <div class="absolute bottom-0 left-0 right-0 p-8 z-20">
                        <h3 class="font-medieval text-3xl text-purple-100 mb-2 group-hover:text-purple-400 transition-colors">Elara</h3>
                        <div class="flex items-center gap-3 mb-4">
                            <span class="px-2 py-0.5 bg-slate-800 border border-slate-700 text-xs uppercase tracking-wider text-slate-300 font-fantasy">Maga</span>
                            <span class="w-1 h-1 bg-purple-500 rounded-full"></span>
                            <span class="text-purple-500/80 font-fantasy text-sm">Nível 5</span>
                        </div>
                        <p class="text-slate-400 text-sm leading-relaxed border-l-2 border-purple-900/50 pl-4 group-hover:border-purple-500 transition-colors">
                            Sussurros arcanos a obedecem. O campo de batalha é apenas mais um pergaminho para ela reescrever.
                        </p>
                    </div>
                </div>

                <!-- Character Card 3 (Rogue) -->
                <div class="group relative bg-black border border-slate-800 hover:border-emerald-600/50 hover:shadow-[0_0_30px_rgba(16,185,129,0.1)] transition-all duration-500 rounded-sm overflow-hidden">
                    <div class="aspect-[3/4] overflow-hidden relative">
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent z-10 opacity-80"></div>
                        <img src="/assets/images/char-rogue.png" alt="Kaelen" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 grayscale-[30%] group-hover:grayscale-0">
                    </div>
                    <div class="absolute bottom-0 left-0 right-0 p-8 z-20">
                        <h3 class="font-medieval text-3xl text-emerald-100 mb-2 group-hover:text-emerald-400 transition-colors">Kaelen</h3>
                        <div class="flex items-center gap-3 mb-4">
                            <span class="px-2 py-0.5 bg-slate-800 border border-slate-700 text-xs uppercase tracking-wider text-slate-300 font-fantasy">Ladino</span>
                            <span class="w-1 h-1 bg-emerald-500 rounded-full"></span>
                            <span class="text-emerald-500/80 font-fantasy text-sm">Nível 5</span>
                        </div>
                        <p class="text-slate-400 text-sm leading-relaxed border-l-2 border-emerald-900/50 pl-4 group-hover:border-emerald-500 transition-colors">
                            Ele é o silêncio entre as batidas do coração. O último rosto que muitos vilões nunca viram.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats / Campaign Info -->
    <section id="campaign" class="py-32 relative overflow-hidden bg-slate-900 border-y border-slate-800">
        <div class="absolute inset-0 bg-[url('/assets/images/bg-dungeon.png')] bg-fixed bg-cover bg-center opacity-5 grayscale"></div>
        <div class="absolute inset-0 bg-slate-900/80"></div>
        
        <div class="container mx-auto px-4 relative z-10">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-12 text-center">
                <div class="group">
                    <div class="font-medieval text-5xl md:text-6xl text-amber-600 mb-2 group-hover:text-amber-400 group-hover:scale-110 transition-all duration-300">12</div>
                    <div class="h-px w-16 bg-slate-700 mx-auto mb-4 group-hover:bg-amber-500 transition-colors"></div>
                    <div class="text-slate-400 text-sm font-fantasy uppercase tracking-widest">Sessões</div>
                </div>
                <div class="group">
                    <div class="font-medieval text-5xl md:text-6xl text-amber-600 mb-2 group-hover:text-amber-400 group-hover:scale-110 transition-all duration-300">3</div>
                    <div class="h-px w-16 bg-slate-700 mx-auto mb-4 group-hover:bg-amber-500 transition-colors"></div>
                    <div class="text-slate-400 text-sm font-fantasy uppercase tracking-widest">Bosses</div>
                </div>
                <div class="group">
                    <div class="font-medieval text-5xl md:text-6xl text-amber-600 mb-2 group-hover:text-amber-400 group-hover:scale-110 transition-all duration-300">452</div>
                    <div class="h-px w-16 bg-slate-700 mx-auto mb-4 group-hover:bg-amber-500 transition-colors"></div>
                    <div class="text-slate-400 text-sm font-fantasy uppercase tracking-widest">Ouro</div>
                </div>
                <div class="group">
                    <div class="font-medieval text-5xl md:text-6xl text-amber-600 mb-2 group-hover:text-amber-400 group-hover:scale-110 transition-all duration-300">∞</div>
                    <div class="h-px w-16 bg-slate-700 mx-auto mb-4 group-hover:bg-amber-500 transition-colors"></div>
                    <div class="text-slate-400 text-sm font-fantasy uppercase tracking-widest">Chaos</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer Refined -->
    <footer class="py-16 bg-black text-center relative border-t border-amber-900/30">
        <div class="container mx-auto px-4">
            <div class="flex flex-col items-center justify-center space-y-6">
                <!-- Iconic Logo -->
                <div class="w-16 h-16 bg-gradient-to-br from-red-900 to-slate-900 rounded-full flex items-center justify-center text-amber-500 font-bold text-2xl border border-amber-700/50 shadow-[0_0_25px_rgba(180,83,9,0.2)]">
                    <span class="font-medieval">AP</span>
                </div>
                
                <!-- Social Runes -->
                <div class="flex space-x-6 text-amber-900">
                    <a href="#" class="hover:text-amber-500 transition-colors hover:scale-110 transform duration-200">{{ ux_icon('lucide:scroll', {class: 'w-6 h-6'}) }}</a>
                    <a href="#" class="hover:text-amber-500 transition-colors hover:scale-110 transform duration-200">{{ ux_icon('lucide:sword', {class: 'w-6 h-6'}) }}</a>
                    <a href="#" class="hover:text-amber-500 transition-colors hover:scale-110 transform duration-200">{{ ux_icon('lucide:crown', {class: 'w-6 h-6'}) }}</a>
                </div>

                <div class="max-w-md mx-auto text-slate-600 text-xs leading-relaxed font-fantasy tracking-wide">
                    <p class="mb-2">© 2025 Sociedade da Adaga de Prata.</p>
                    <p>Todas as histórias narradas aqui são fictícias. Qualquer semelhança com dragões reais ou liches existentes é mera coincidência (e muito azar).</p>
                </div>
            </div>
        </div>
    </footer>
{% endblock %}
